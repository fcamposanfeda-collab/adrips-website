---
import { getPageMeta } from '../data/pages-meta';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/sections/PageIntro.astro';
import PortfolioSection from '../components/sections/PortfolioSection.astro';

const meta = getPageMeta('/proyectos');
---

<BaseLayout title={meta.title} description={meta.description}>
  <PageIntro
    eyebrow="Proyectos"
    title="Trabajos y campañas que cuentan historias"
    description="Desde Exaccta Xpens hasta activaciones virales como #ElWallpaperDeIbai en Finetwork — con enlaces a webs, redes y prensa."
  />
  <PortfolioSection compact />
</BaseLayout>
