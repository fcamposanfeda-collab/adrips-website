---
import { getPageMeta } from '../data/pages-meta';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/sections/PageIntro.astro';
import PortfolioSection from '../components/sections/PortfolioSection.astro';
import ContactCta from '../components/sections/ContactCta.astro';

const meta = getPageMeta('/proyectos');
---

<BaseLayout title={meta.title} description={meta.description}>
  <PageIntro
    eyebrow="Proyectos"
    title="Webs y campañas"
    emphasis="con resultados"
    description="Proyectos de diseño web a medida y casos reales de marketing digital. Los casos web completos se publican a medida que se lanzan."
  />
  <PortfolioSection />
  <ContactCta formId="projects-contact" />
</BaseLayout>
