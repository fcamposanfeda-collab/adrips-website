---
/**
 * Plantilla de página de servicio. El contenido vive en src/data/services.ts (campo `page`).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/sections/PageIntro.astro';
import ServicesGrid from '../../components/sections/ServicesGrid.astro';
import ContactCta from '../../components/sections/ContactCta.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import { services, type Service } from '../../data/services';
import { routes } from '../../data/routes';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

interface Props {
  service: Service;
}

const { service } = Astro.props;
const { page } = service;

const faqSchema = page.faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: page.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  description: page.metaDescription,
  provider: { '@id': 'https://adripsmarketing.com/#person' },
  areaServed: 'ES',
};
---

<BaseLayout title={page.metaTitle} description={page.metaDescription}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(serviceSchema)} />

  <nav class="crumbs container" aria-label="Migas de pan">
    <a href="/">Inicio</a>
    <span aria-hidden="true">/</span>
    <a href={routes.services}>Servicios</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{service.title}</span>
  </nav>

  <PageIntro eyebrow="Servicios" title={page.heading} emphasis={page.emphasis} description={page.lead} />

  <div class="container svc-hero-actions" data-reveal>
    <Button href={routes.contact} variant="primary" size="lg" arrow>Pide tu propuesta</Button>
    <span class="svc-hero-icon" aria-hidden="true"><Icon name={service.icon} size={28} /></span>
  </div>

  <section class="section svc-includes" aria-labelledby="includes-title">
    <div class="container">
      <header class="section-header" data-reveal>
        <p class="eyebrow">Qué incluye</p>
        <h2 id="includes-title">Todo lo que necesitas, <em>bien hecho</em></h2>
      </header>
      <ol class="includes__grid">
        {
          page.includes.map((item, i) => (
            <li class="include" data-reveal data-reveal-delay={String((i % 3) + 1)}>
              <span class="include__num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section surface-dark grain" aria-labelledby="outcomes-title">
    <div class="container outcomes">
      <header data-reveal>
        <p class="eyebrow">Qué consigues</p>
        <h2 id="outcomes-title">Resultados que <em>se notan</em></h2>
      </header>
      <ul class="outcomes__list" data-reveal data-reveal-delay="1">
        {
          page.outcomes.map((o) => (
            <li>
              <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
                <path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              {o}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section surface-soft" aria-labelledby="steps-title">
    <div class="container">
      <header class="section-header" data-reveal>
        <p class="eyebrow">Cómo trabajamos</p>
        <h2 id="steps-title">Paso a paso, <em>sin sorpresas</em></h2>
      </header>
      <ol class="steps">
        {
          page.steps.map((s, i) => (
            <li class="step" data-reveal data-reveal-delay={String(i + 1)}>
              <span class="step__num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    page.faqs.length > 0 && (
      <section class="section svc-faq" aria-labelledby="svc-faq-title">
        <div class="container svc-faq__grid">
          <header data-reveal>
            <p class="eyebrow">Dudas frecuentes</p>
            <h2 id="svc-faq-title">Preguntas <em>frecuentes</em></h2>
          </header>
          <div data-reveal data-reveal-delay="1">
            {page.faqs.map((f, i) => (
              <details class="faq-item" open={i === 0}>
                <summary>
                  <span>{f.q}</span>
                  <span class="faq-item__icon" aria-hidden="true" />
                </summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </div>
        {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
      </section>
    )
  }

  <ServicesGrid exclude={service.slug} title="Otros servicios" />
  <ContactCta formId={`contact-${service.slug}`} />
</BaseLayout>

<style>
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 1.5rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .crumbs a:hover {
    color: var(--accent);
  }

  .crumbs [aria-current] {
    color: var(--ink);
    font-weight: 600;
  }

  :global(.crumbs + .page-intro) {
    padding-top: 2.5rem;
  }

  .svc-hero-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: -0.5rem;
  }

  .svc-hero-icon {
    display: none;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    color: var(--accent);
    background: var(--accent-soft);
  }

  .includes__grid {
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .include {
    padding: 2rem 1.75rem;
    background: var(--white);
  }

  .include__num {
    display: block;
    margin-bottom: 1.75rem;
    font-family: var(--font-heading);
    font-style: italic;
    color: var(--accent);
  }

  .include h3 {
    margin: 0 0 0.5rem;
    font-size: 1.375rem;
  }

  .include p {
    margin: 0;
    font-size: 0.9875rem;
    color: var(--muted);
  }

  .outcomes {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  .outcomes h2 {
    margin: 0;
  }

  .outcomes__list {
    display: grid;
    gap: 0.75rem;
  }

  .outcomes__list li {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.125rem 1.25rem;
    font-size: 1.0625rem;
    border: 1px solid rgba(251, 244, 236, 0.14);
    border-radius: var(--radius-md);
  }

  .outcomes__list svg {
    flex-shrink: 0;
    color: var(--accent-light);
  }

  .steps {
    display: grid;
    gap: 1rem;
  }

  .step {
    padding: 1.75rem;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .step__num {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: 2rem;
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--white);
    background: var(--ink);
    border-radius: 50%;
  }

  .step:first-child .step__num {
    background: var(--accent);
  }

  .step h3 {
    margin: 0 0 0.5rem;
    font-size: 1.375rem;
  }

  .step p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9875rem;
  }

  .svc-faq__grid {
    display: grid;
    gap: 2rem;
  }

  .svc-faq h2 {
    margin: 0;
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
  }

  .faq-item {
    border-bottom: 1px solid var(--line);
  }

  .faq-item:first-child {
    border-top: 1px solid var(--line);
  }

  .faq-item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding-block: 1.375rem;
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item__icon {
    position: relative;
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    transition: transform 300ms var(--ease-out);
  }

  .faq-item__icon::before,
  .faq-item__icon::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    width: 10px;
    height: 1.5px;
    background: currentColor;
    transform: translate(-50%, -50%);
  }

  .faq-item__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .faq-item[open] .faq-item__icon {
    transform: rotate(45deg);
    background: var(--ink);
    border-color: var(--ink);
    color: var(--white);
  }

  .faq-item p {
    margin: -0.25rem 0 1.375rem;
    color: var(--muted);
  }

  @media (min-width: 640px) {
    .includes__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 900px) {
    .svc-hero-icon {
      display: grid;
    }

    .includes__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .outcomes {
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
    }

    .steps {
      grid-template-columns: repeat(3, 1fr);
    }

    .svc-faq__grid {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 5rem;
    }
  }
</style>
