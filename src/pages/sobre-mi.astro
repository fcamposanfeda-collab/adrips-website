---
import { getPageMeta } from '../data/pages-meta';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/sections/PageIntro.astro';
import AboutSection from '../components/sections/AboutSection.astro';
import ExperienceSection from '../components/sections/ExperienceSection.astro';
import EducationSection from '../components/sections/EducationSection.astro';
import ValuesSection from '../components/sections/ValuesSection.astro';
import ContactCta from '../components/sections/ContactCta.astro';

const meta = getPageMeta('/sobre-mi');
---

<BaseLayout title={meta.title} description={meta.description}>
  <PageIntro
    wide
    eyebrow="Sobre mí"
    title="Un poco más sobre mí"
    description="Diseñadora web y especialista en marketing digital, con más de 5 años de experiencia en SaaS, fintech y B2B."
    descriptionExtra="Creativa, orientada a datos y con muchas ganas de seguir aprendiendo."
  />
  <AboutSection compact />
  <ExperienceSection />
  <EducationSection />
  <ValuesSection />
  <ContactCta formId="about-contact" />
</BaseLayout>
