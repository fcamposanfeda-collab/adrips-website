---
import { getPageMeta } from '../data/pages-meta';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/sections/PageIntro.astro';
import ServicesGrid from '../components/sections/ServicesGrid.astro';
import ProcessSection from '../components/sections/ProcessSection.astro';
import PricingSection from '../components/sections/PricingSection.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import ContactCta from '../components/sections/ContactCta.astro';

const meta = getPageMeta('/servicios');
---

<BaseLayout title={meta.title} description={meta.description}>
  <PageIntro
    eyebrow="Servicios"
    title="Una web profesional"
    emphasis="y el marketing que la hace rendir"
    description="Diseño y desarrollo webs y landing pages a medida. Y si quieres que además te traigan clientes, me encargo del SEO, las campañas y la estrategia."
  />
  <ServicesGrid detailed />
  <ProcessSection />
  <PricingSection />
  <FaqSection />
  <ContactCta formId="services-contact" />
</BaseLayout>
