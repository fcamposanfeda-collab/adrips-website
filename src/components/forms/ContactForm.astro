---
import { formConfig } from '../../data/form-config';
import { owner } from '../../data/owner';

interface Props {
  formId?: string;
  /** contact = presupuesto completo · audit = revisión gratuita (web + email) */
  variant?: 'contact' | 'audit';
}

const { formId = 'contact', variant = 'contact' } = Astro.props;
const isAudit = variant === 'audit';
const urlId = `${formId}-web`;

/** Opciones en botones: se rellenan con un toque y cualifican el contacto */
const choiceGroups = [
  {
    name: 'necesidad',
    legend: '¿Qué necesitas?',
    multiple: true,
    options: ['Web nueva', 'Rediseño', 'Aparecer en Google', 'Publicidad', 'Redes sociales', 'Otro'],
  },
  {
    name: 'presupuesto',
    legend: 'Presupuesto orientativo',
    multiple: true,
    options: ['Menos de 500 €', '500 – 1.000 €', '1.000 – 2.500 €', 'Más de 2.500 €', 'Aún no lo sé'],
  },
  {
    name: 'plazo',
    legend: '¿Para cuándo?',
    multiple: false,
    options: ['Lo antes posible', 'En 1 – 2 meses', 'Sin prisa'],
  },
];
const { endpoint: formEndpoint, web3formsAccessKey: web3formsKey } = formConfig;
const nameId = `${formId}-nombre`;
const emailId = `${formId}-email`;
const messageId = `${formId}-mensaje`;
const statusId = `${formId}-status`;
const honeypotId = `${formId}-company`;
---

<form
  class="contact-form"
  method="post"
  action={formEndpoint || '#'}
  data-contact-form
  data-form-endpoint={formEndpoint}
  data-form-configured={formConfig.isConfigured ? 'true' : 'false'}
  novalidate
>
  <div class="contact-form__honeypot" aria-hidden="true">
    <label for={honeypotId}>Empresa</label>
    <input type="text" id={honeypotId} name="company" tabindex="-1" autocomplete="off" />
  </div>

  {web3formsKey && <input type="hidden" name="access_key" value={web3formsKey} />}
  <input
    type="hidden"
    name="subject"
    value={isAudit ? `Revisión gratuita de web — ${owner.fullName}` : `Nuevo mensaje — ${owner.fullName}`}
  />
  <input type="hidden" name="tipo_solicitud" value={isAudit ? 'Revisión gratuita' : 'Contacto / presupuesto'} />
  <input type="hidden" name="from_name" value={`Web ${owner.fullName}`} />

  {
    isAudit && (
      <div class="contact-form__field">
        <label class="contact-form__label" for={urlId}>
          Tu web<span class="contact-form__required">*</span>
        </label>
        <input
          class="contact-form__input"
          type="text"
          id={urlId}
          name="web"
          inputmode="url"
          autocomplete="url"
          placeholder="tunegocio.com"
          required
        />
      </div>
    )
  }

  {!isAudit && (
  <div class="contact-form__field">
    <label class="contact-form__label" for={nameId}>
      Nombre<span class="contact-form__required">*</span>
    </label>
    <input
      class="contact-form__input"
      type="text"
      id={nameId}
      name="nombre"
      autocomplete="name"
      required
    />
  </div>
  )}

  <div class="contact-form__field">
    <label class="contact-form__label" for={emailId}>
      Correo electrónico<span class="contact-form__required">*</span>
    </label>
    <input
      class="contact-form__input"
      type="email"
      id={emailId}
      name="email"
      autocomplete="email"
      required
    />
  </div>

  {
    !isAudit &&
      choiceGroups.map((group) => (
        <fieldset class="contact-form__choices">
          <legend class="contact-form__label">
            {group.legend}
            {group.multiple && <span class="contact-form__optional"> (puedes elegir varias)</span>}
          </legend>
          {/* Las casillas múltiples se envían juntas en un campo oculto: «Web nueva, Aparecer en Google» */}
          {group.multiple && <input type="hidden" name={group.name} value="" data-choice-target={group.name} />}
          <div class="contact-form__chips">
            {group.options.map((option) =>
              group.multiple ? (
                <label class="contact-form__chip">
                  <input type="checkbox" value={option} data-choice-group={group.name} />
                  <span>{option}</span>
                </label>
              ) : (
                <label class="contact-form__chip">
                  <input type="radio" name={group.name} value={option} />
                  <span>{option}</span>
                </label>
              ),
            )}
          </div>
        </fieldset>
      ))
  }

  {
    !isAudit && (
      <div class="contact-form__field">
        <label class="contact-form__label" for={messageId}>
          Cuéntame algo más <span class="contact-form__optional">(opcional)</span>
        </label>
        <textarea
          class="contact-form__input contact-form__textarea"
          id={messageId}
          name="mensaje"
          rows="3"
          placeholder="A qué se dedica tu negocio, si ya tienes web, alguna idea que te guste…"
        />
      </div>
    )
  }

  <p class="contact-form__status" id={statusId} role="status" aria-live="polite" hidden data-form-status></p>

  <button type="submit" class="contact-form__submit">{isAudit ? 'Quiero mi revisión gratis →' : 'Enviar mensaje →'}</button>
  <p class="contact-form__note">
    Tus datos solo se usan para responderte. <a href="/politica-de-privacidad">Política de privacidad</a>.
  </p>
</form>

<style>
  .contact-form {
    display: grid;
    gap: 1.25rem;
  }

  .contact-form__honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }

  .contact-form__field {
    display: grid;
    gap: 0.5rem;
  }

  .contact-form__label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink);
  }

  .contact-form__required {
    margin-left: 0.125rem;
    color: var(--accent);
  }

  .contact-form__input {
    width: 100%;
    padding: 0.9375rem 1rem;
    font: inherit;
    font-size: 1rem;
    color: var(--ink);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--white);
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .contact-form__input::placeholder {
    color: #9b8a90;
  }

  .contact-form__input:hover {
    border-color: var(--muted);
  }

  .contact-form__input:focus {
    outline: none;
    border-color: var(--ink);
    box-shadow: 0 0 0 4px rgba(163, 95, 107, 0.14);
  }

  .contact-form__textarea {
    resize: vertical;
    min-height: 6rem;
  }

  .contact-form__optional {
    font-weight: 500;
    color: var(--muted);
  }

  .contact-form__choices {
    display: grid;
    gap: 0.625rem;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .contact-form__choices legend {
    padding: 0;
    margin-bottom: 0.625rem;
  }

  .contact-form__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .contact-form__chip {
    position: relative;
    cursor: pointer;
  }

  .contact-form__chip input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }

  .contact-form__chip span {
    display: inline-block;
    padding: 0.5rem 0.9375rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ink);
    background: var(--white);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-full);
    transition:
      background var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast);
  }

  .contact-form__chip:hover span {
    border-color: var(--accent);
  }

  .contact-form__chip input:checked + span {
    color: var(--white);
    background: var(--accent);
    border-color: var(--accent);
  }

  .contact-form__chip input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .contact-form__status {
    margin: 0;
    padding: 0.75rem 1rem;
    font-size: 0.9375rem;
    border-radius: var(--radius-sm);
  }

  .contact-form__status[data-type='success'] {
    color: #2f5a29;
    background: #e3eddd;
  }

  .contact-form__status[data-type='error'] {
    color: #8a2a22;
    background: var(--accent-soft);
  }

  .contact-form__submit {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    padding: 1.0625rem 1.5rem;
    font-weight: 600;
    font-size: 1rem;
    color: var(--white);
    background: var(--accent);
    border: none;
    border-radius: var(--radius-full);
    cursor: pointer;
    box-shadow: 0 10px 24px -10px rgba(163, 95, 107, 0.7);
    transition:
      transform var(--transition-bounce),
      background var(--transition-fast);
  }

  .contact-form__submit:hover {
    background: var(--accent-hover);
    transform: translateY(-2px);
  }

  .contact-form__submit:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .contact-form__note {
    margin: -0.25rem 0 0;
    font-size: 0.8125rem;
    color: var(--muted);
    text-align: center;
  }

  .contact-form__note a {
    text-decoration: underline;
  }
</style>

<script>
  function showStatus(form: HTMLFormElement, message: string, type: 'success' | 'error') {
    const status = form.querySelector('[data-form-status]');
    if (!(status instanceof HTMLElement)) return;
    status.textContent = message;
    status.dataset.type = type;
    status.hidden = false;
  }

  document.querySelectorAll('[data-contact-form]').forEach((element) => {
    if (!(element instanceof HTMLFormElement)) return;
    const form = element;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const honeypot = form.querySelector('input[name="company"]');
      if (honeypot instanceof HTMLInputElement && honeypot.value.trim()) return;

      form.querySelectorAll<HTMLInputElement>('[data-choice-target]').forEach((hidden) => {
        const name = hidden.dataset.choiceTarget;
        hidden.value = Array.from(
          form.querySelectorAll<HTMLInputElement>(`input[data-choice-group="${name}"]:checked`),
        )
          .map((box) => box.value)
          .join(', ');
      });

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      if (form.dataset.formConfigured !== 'true') {
        showStatus(
          form,
          'Formulario en configuración. Escríbeme directamente por email mientras tanto.',
          'error',
        );
        return;
      }

      const endpoint = form.dataset.formEndpoint ?? '';
      const submit = form.querySelector('button[type="submit"]');
      if (submit instanceof HTMLButtonElement) submit.disabled = true;

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!response.ok) throw new Error('Network error');
        form.reset();
        showStatus(
          form,
          form.querySelector('input[name="web"]')
            ? '¡Recibido! En menos de 72 h te envío la revisión de tu web.'
            : '¡Mensaje enviado! Te responderé en menos de 24 h.',
          'success',
        );
      } catch {
        showStatus(form, 'Error al enviar. Inténtalo de nuevo o escríbeme por email.', 'error');
      } finally {
        if (submit instanceof HTMLButtonElement) submit.disabled = false;
      }
    });
  });
</script>
