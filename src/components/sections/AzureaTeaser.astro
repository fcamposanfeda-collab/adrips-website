---
import Button from '../ui/Button.astro';
import { azureaTeaser } from '../../data/eventos';
---

<section class="azurea section" aria-labelledby="azurea-title">
  <div class="container">
    <div class="azurea__card" data-reveal>
      <div class="azurea__content">
        <p class="azurea__eyebrow">{azureaTeaser.eyebrow}</p>
        <h2 id="azurea-title">{azureaTeaser.title}</h2>
        <p class="azurea__desc">{azureaTeaser.description}</p>
        <ul class="azurea__features">
          {
            azureaTeaser.features.map((feature) => (
              <li>
                <span aria-hidden="true">✓</span>
                {feature}
              </li>
            ))
          }
        </ul>
        <div class="azurea__cta">
          <Button href={azureaTeaser.ctaHref} variant="secondary" external>
            {azureaTeaser.ctaLabel}
          </Button>
        </div>
      </div>
      <div class="azurea__visual">
        <img
          class="azurea__image"
          src={azureaTeaser.image.src}
          alt={azureaTeaser.image.alt}
          width="640"
          height="480"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .azurea {
    background: var(--color-bg-soft);
  }

  .azurea__card {
    display: grid;
    gap: 2rem;
    padding: 2.5rem;
    background: linear-gradient(
      135deg,
      rgba(200, 176, 224, 0.15) 0%,
      rgba(255, 252, 250, 0.95) 50%,
      rgba(232, 184, 184, 0.12) 100%
    );
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  .azurea__eyebrow {
    display: inline-block;
    margin: 0 0 0.75rem;
    padding: 0.375rem 0.875rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-lila-strong);
    background: rgba(196, 181, 253, 0.25);
    border-radius: var(--radius-full);
  }

  .azurea h2 {
    margin: 0 0 1rem;
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 2.75rem);
    color: var(--color-text);
  }

  .azurea__desc {
    margin: 0 0 1.5rem;
    font-size: 1.0625rem;
    color: var(--color-muted);
    line-height: 1.75;
    max-width: 36rem;
  }

  .azurea__features {
    display: grid;
    gap: 0.625rem;
    margin: 0 0 2rem;
    padding: 0;
    list-style: none;
  }

  .azurea__features li {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.5;
  }

  .azurea__features span {
    flex-shrink: 0;
    color: var(--color-brand-pink-deep);
    font-weight: 700;
  }

  .azurea__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .azurea__visual {
    position: relative;
    min-height: 12rem;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-bg-soft);
  }

  .azurea__image {
    width: 100%;
    height: 100%;
    min-height: 12rem;
    object-fit: cover;
    object-position: center 35%;
  }

  @media (min-width: 768px) {
    .azurea__card {
      grid-template-columns: 1.2fr 0.8fr;
      align-items: center;
      padding: 3rem;
    }

    .azurea__visual,
    .azurea__image {
      min-height: 16rem;
    }
  }
</style>
