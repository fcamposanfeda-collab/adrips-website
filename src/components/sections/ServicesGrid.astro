---
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import { services, serviceHref } from '../../data/services';
import { routes } from '../../data/routes';

interface Props {
  /** Versión de la página Servicios: descripción larga y lo que incluye */
  detailed?: boolean;
  /** Oculta un servicio (p. ej. el de la página actual) */
  exclude?: string;
  title?: string;
}

const { detailed = false, exclude, title } = Astro.props;
const list = services.filter((s) => s.slug !== exclude);
---

<section id="servicios" class="services section" aria-labelledby="services-title">
  <div class="container">
    {
      !detailed && !title && (
        <header class="section-header section-header--split" data-reveal>
          <div>
            <p class="eyebrow">Servicios</p>
            <h2 id="services-title">
              Tu web, <em>y todo lo que la hace funcionar</em>
            </h2>
          </div>
          <p>
            El centro es tu web. Alrededor, el marketing y el diseño que le traen visitas y las convierten en
            clientes. Lo contratas por separado o todo junto.
          </p>
        </header>
      )
    }
    {
      title && (
        <header class="section-header" data-reveal>
          <h2 id="services-title" class="services__small-title">{title}</h2>
        </header>
      )
    }
    {detailed && <h2 id="services-title" class="visually-hidden">Servicios</h2>}

    <ul class:list={['services__grid', { 'services__grid--compact': !!exclude }]}>
      {
        list.map((s, i) => (
          <li data-reveal data-reveal-delay={String((i % 3) + 1)}>
            <a href={serviceHref(s)} class:list={['svc-card', { 'svc-card--dark': i === 0 && !exclude }]}>
              <div class="svc-card__top">
                <span class="svc-card__icon">
                  <Icon name={s.icon} size={24} />
                </span>
                <span class="svc-card__arrow" aria-hidden="true">
                  <svg viewBox="0 0 16 16" width="16" height="16" fill="none">
                    <path d="M4 12L12 4M6 4h6v6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </div>
              <h3>{s.title}</h3>
              <p>{detailed ? s.description : s.summary}</p>
              {detailed && (
                <ul class="svc-card__tags">
                  {s.features.map((f) => (
                    <li>{f}</li>
                  ))}
                </ul>
              )}
            </a>
          </li>
        ))
      }
    </ul>

    {
      !detailed && !exclude && (
        <div class="services__footer" data-reveal>
          <Button href={routes.services} variant="outline" arrow>
            Ver todos los servicios
          </Button>
        </div>
      )
    }
  </div>
</section>

<style>
  .services__small-title {
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
  }

  .services__grid {
    display: grid;
    gap: 1rem;
  }

  .services__grid > li {
    display: flex;
  }

  .svc-card {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 2rem 1.75rem;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition:
      transform var(--transition-bounce),
      box-shadow var(--transition-fast),
      border-color var(--transition-fast);
  }

  .svc-card:hover {
    transform: translateY(-4px);
    border-color: var(--blush);
    box-shadow: var(--shadow-hover);
  }

  .svc-card--dark {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--color-on-dark);
  }

  .svc-card--dark::after {
    content: '';
    position: absolute;
    right: -6rem;
    top: -6rem;
    width: 18rem;
    height: 18rem;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(227, 169, 174, 0.35), transparent);
    pointer-events: none;
  }

  .svc-card__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 2.25rem;
  }

  .svc-card__icon {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: var(--radius-sm);
    color: var(--accent);
    background: var(--accent-soft);
  }

  .svc-card--dark .svc-card__icon {
    color: var(--ink);
    background: var(--accent-light);
  }

  .svc-card__arrow {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    color: var(--ink);
    transition:
      transform var(--transition-bounce),
      background var(--transition-fast),
      color var(--transition-fast);
  }

  .svc-card--dark .svc-card__arrow {
    border-color: rgba(251, 244, 236, 0.25);
    color: var(--color-on-dark);
  }

  .svc-card:hover .svc-card__arrow {
    transform: rotate(45deg);
    background: var(--accent);
    border-color: var(--accent);
    color: var(--white);
  }

  .svc-card h3 {
    margin: 0 0 0.625rem;
    font-size: clamp(1.375rem, 2.2vw, 1.75rem);
    transition: color var(--transition-fast);
  }

  .svc-card--dark h3 {
    color: var(--color-on-dark);
  }

  .svc-card p {
    margin: 0;
    font-size: 0.9875rem;
    color: var(--muted);
  }

  .svc-card--dark p {
    color: rgba(251, 244, 236, 0.72);
  }

  .svc-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .svc-card--dark .svc-card__tags {
    border-color: rgba(251, 244, 236, 0.14);
  }

  .svc-card__tags li {
    padding: 0.3rem 0.7rem;
    font-size: 0.8125rem;
    font-weight: 500;
    border-radius: var(--radius-full);
    background: var(--paper-2);
    color: var(--ink-soft);
  }

  .svc-card--dark .svc-card__tags li {
    background: rgba(251, 244, 236, 0.08);
    color: rgba(251, 244, 236, 0.86);
  }

  .services__footer {
    margin-top: 2.5rem;
  }

  @media (min-width: 640px) {
    .services__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1000px) {
    .services__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .services__grid--compact {
      grid-template-columns: repeat(5, 1fr);
    }

    .services__grid--compact .svc-card {
      padding: 1.5rem 1.25rem;
    }

    .services__grid--compact .svc-card h3 {
      font-size: 1.25rem;
    }

    .services__grid--compact .svc-card__top {
      margin-bottom: 1.5rem;
    }
  }
</style>
