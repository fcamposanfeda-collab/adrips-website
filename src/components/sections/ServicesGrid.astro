---
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import { primaryServices, growthServices } from '../../data/services';
import { routes } from '../../data/routes';

interface Props {
  /** Versión de la página Servicios: muestra la lista completa de lo que incluye */
  detailed?: boolean;
}

const { detailed = false } = Astro.props;
---

<section id="servicios" class="services section" aria-labelledby="services-title">
  <div class="container">
    {
      !detailed && (
        <header class="section-header section-header--split" data-reveal>
          <div>
            <p class="eyebrow">Servicios</p>
            <h2 id="services-title">
              Tu web, <em>y todo lo que la hace funcionar</em>
            </h2>
          </div>
          <p>
            El centro es tu web. Alrededor, el marketing que le trae visitas y las convierte en clientes. Lo
            contratas por separado o todo junto.
          </p>
        </header>
      )
    }
    {detailed && <h2 id="services-title" class="visually-hidden">Servicios</h2>}

    <div class="services__primary">
      {
        primaryServices.map((s, i) => (
          <article class:list={['svc-feature', { 'svc-feature--dark': i === 0 }]} data-reveal data-reveal-delay={String(i + 1)}>
            <div class="svc-feature__icon">
              <Icon name={s.icon} size={26} />
            </div>
            <h3>{s.title}</h3>
            <p>{detailed ? s.description : s.summary}</p>
            <ul class="svc-feature__tags">
              {(detailed ? s.features : s.features.slice(0, 4)).map((f) => (
                <li>{f}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <div class="services__growth" data-reveal>
      <p class="services__growth-title">Para que tu web crezca</p>
      <ul class="services__list">
        {
          growthServices.map((s) => (
            <li class="svc-row">
              <span class="svc-row__icon">
                <Icon name={s.icon} size={22} />
              </span>
              <div class="svc-row__body">
                <h3>{s.title}</h3>
                <p>{detailed ? s.description : s.summary}</p>
                {detailed && (
                  <ul class="svc-row__features">
                    {s.features.map((f) => (
                      <li>{f}</li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    {
      !detailed && (
        <div class="services__footer" data-reveal>
          <Button href={routes.services} variant="outline" arrow>
            Ver servicios en detalle
          </Button>
        </div>
      )
    }
  </div>
</section>

<style>
  .services__primary {
    display: grid;
    gap: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .svc-feature {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 2.25rem 2rem;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition:
      transform var(--transition-bounce),
      box-shadow var(--transition-fast);
  }

  .svc-feature:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
  }

  .svc-feature--dark {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--color-on-dark);
  }

  .svc-feature--dark::after {
    content: '';
    position: absolute;
    right: -6rem;
    top: -6rem;
    width: 18rem;
    height: 18rem;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(232, 141, 128, 0.35), transparent);
    pointer-events: none;
  }

  .svc-feature__icon {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    margin-bottom: 2.5rem;
    border-radius: var(--radius-sm);
    color: var(--accent);
    background: var(--accent-soft);
  }

  .svc-feature--dark .svc-feature__icon {
    color: var(--ink);
    background: var(--accent-light);
  }

  .svc-feature h3 {
    margin: 0 0 0.75rem;
    font-size: clamp(1.5rem, 2.6vw, 2rem);
  }

  .svc-feature--dark h3 {
    color: var(--color-on-dark);
  }

  .svc-feature p {
    margin: 0 0 1.75rem;
    color: var(--muted);
    max-width: 34rem;
  }

  .svc-feature--dark p {
    color: rgba(251, 244, 236, 0.72);
  }

  .svc-feature__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
  }

  .svc-feature__tags li {
    padding: 0.375rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
    border-radius: var(--radius-full);
    border: 1px solid var(--line);
    color: var(--ink-soft);
  }

  .svc-feature--dark .svc-feature__tags li {
    border-color: rgba(251, 244, 236, 0.18);
    color: rgba(251, 244, 236, 0.86);
  }

  .services__growth {
    padding: 2rem;
    background: var(--paper-2);
    border-radius: var(--radius-lg);
  }

  .services__growth-title {
    margin: 0 0 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .services__list {
    display: grid;
  }

  .svc-row {
    display: flex;
    gap: 1.25rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--line-strong);
  }

  .svc-row:last-child {
    border-bottom: 0;
    padding-bottom: 0.25rem;
  }

  .svc-row__icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--white);
    color: var(--accent);
  }

  .svc-row h3 {
    margin: 0 0 0.25rem;
    font-size: 1.25rem;
  }

  .svc-row p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .svc-row__features {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1rem;
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink-soft);
  }

  .svc-row__features li::before {
    content: '·';
    margin-right: 0.375rem;
    color: var(--accent);
  }

  .services__footer {
    margin-top: 2.5rem;
  }

  @media (min-width: 768px) {
    .services__primary {
      grid-template-columns: 1.3fr 1fr;
    }

    .services__growth {
      padding: 2.5rem 3rem;
    }

    .services__list {
      grid-template-columns: 1fr 1fr;
      column-gap: 3rem;
    }

    .svc-row:nth-last-child(2) {
      border-bottom: 0;
      padding-bottom: 0.25rem;
    }
  }
</style>
