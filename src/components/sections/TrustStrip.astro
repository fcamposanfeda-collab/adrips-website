---
import { trustedBy } from '../../data/home';

const items = [...trustedBy, ...trustedBy];
---

<section class="trust" aria-label="Experiencia en marketing">
  <div class="container trust__inner">
    <p class="trust__label">5 años llevando el marketing digital de marcas como</p>
    <div class="trust__marquee">
      <ul class="trust__track">
        {
          items.map((name, i) => (
            <li aria-hidden={i >= trustedBy.length ? 'true' : undefined}>
              <span>{name}</span>
              <svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true">
                <path d="M12 1c.6 6.6 4.4 10.4 11 11-6.6.6-10.4 4.4-11 11-.6-6.6-4.4-10.4-11-11C7.6 11.4 11.4 7.6 12 1z" fill="currentColor" />
              </svg>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .trust {
    border-block: 1px solid var(--line);
    background: var(--white);
  }

  .trust__inner {
    display: grid;
    gap: 1rem;
    align-items: center;
    padding-block: 1.75rem;
  }

  .trust__label {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--muted);
  }

  .trust__marquee {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }

  .trust__track {
    display: flex;
    width: max-content;
    animation: marquee 32s linear infinite;
  }

  .trust__track li {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    padding-right: 2.5rem;
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 2.4vw, 1.625rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .trust__track svg {
    color: var(--accent);
    opacity: 0.6;
  }

  @media (min-width: 900px) {
    .trust__inner {
      grid-template-columns: 14rem 1fr;
      gap: 2.5rem;
    }
  }
</style>
