---
import { experience } from '../../data/experience';
---

<section class="experience section" aria-labelledby="experience-title">
  <div class="container">
    <header class="section-header">
      <p class="section-header__eyebrow">Trayectoria</p>
      <h2 id="experience-title">Experiencia profesional</h2>
      <p>
        Más de 5 años en marketing digital, desde community management hasta responsable de
        departamento.
      </p>
    </header>

    <ol class="experience__list">
      {
        experience.map((job) => (
          <li class={`experience-card experience-card--${job.accent}`}>
            <div class="experience-card__meta">
              <span class="experience-card__period">{job.period}</span>
              <h3>{job.role}</h3>
              <p class="experience-card__company">
                {job.company} · {job.sector}
              </p>
            </div>
            <ul class="experience-card__highlights">
              {job.highlights.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .experience {
    background: var(--color-surface);
  }

  .experience__list {
    display: grid;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .experience-card {
    display: grid;
    gap: 1rem;
    padding: 1.75rem;
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    transition: border-color var(--transition-fast);
  }

  .experience-card:hover {
    border-color: var(--color-lila);
  }

  .experience-card--lila:hover {
    border-color: var(--color-lila);
  }

  .experience-card--rosa:hover {
    border-color: var(--color-rosa);
  }

  .experience-card--menta:hover {
    border-color: var(--color-menta);
  }

  .experience-card--naranja:hover {
    border-color: var(--color-naranja);
  }

  .experience-card__period {
    display: inline-block;
    margin-bottom: 0.5rem;
    padding: 0.25rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-lila-strong);
    background: rgba(196, 181, 253, 0.25);
    border-radius: var(--radius-full);
  }

  .experience-card h3 {
    margin: 0 0 0.375rem;
    font-size: 1.25rem;
  }

  .experience-card__company {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-muted);
  }

  .experience-card__highlights {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .experience-card__highlights li {
    position: relative;
    padding-left: 1.25rem;
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.6;
  }

  .experience-card__highlights li::before {
    content: '·';
    position: absolute;
    left: 0;
    font-weight: 700;
    color: var(--color-lila-strong);
  }

  @media (min-width: 768px) {
    .experience-card {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: start;
      gap: 2rem;
    }
  }
</style>
