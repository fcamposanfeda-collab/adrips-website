---
interface Props {
  eyebrow: string;
  title: string;
  /** Parte del título que va en cursiva de acento */
  emphasis?: string;
  description?: string;
  descriptionExtra?: string;
  wide?: boolean;
}

const { eyebrow, title, emphasis, description, descriptionExtra } = Astro.props;
---

<header class="page-intro">
  <div class="page-intro__glow" aria-hidden="true"></div>
  <div class="container page-intro__inner">
    <p class="eyebrow" data-reveal-now>{eyebrow}</p>
    <h1 class="page-intro__title" data-reveal-now data-reveal-delay="1">
      {title}{emphasis && <> <em>{emphasis}</em></>}
    </h1>
    {
      (description || descriptionExtra) && (
        <div class="page-intro__copy" data-reveal-now data-reveal-delay="2">
          {description && <p class="lead">{description}</p>}
          {descriptionExtra && <p class="lead">{descriptionExtra}</p>}
        </div>
      )
    }
  </div>
</header>

<style>
  .page-intro {
    position: relative;
    overflow: hidden;
    padding-block: 4rem 3rem;
  }

  .page-intro__glow {
    position: absolute;
    right: -15rem;
    top: -20rem;
    width: 50rem;
    height: 50rem;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(239, 205, 208, 0.7), transparent);
    pointer-events: none;
  }

  .page-intro__inner {
    position: relative;
  }

  .page-intro__title {
    margin: 0 0 1.5rem;
    max-width: 16ch;
    font-size: clamp(2.5rem, 6.4vw, 4.75rem);
  }

  .page-intro__copy {
    display: grid;
    gap: 0.75rem;
    max-width: 40rem;
  }

  .page-intro__copy p {
    margin: 0;
  }

  @media (min-width: 768px) {
    .page-intro {
      padding-block: 6rem 4rem;
    }
  }
</style>
