---
import ContactForm from '../forms/ContactForm.astro';
import { contact } from '../../data/site';

interface Props {
  /** En la página de contacto el H1 lo pone la propia página */
  compact?: boolean;
  formId?: string;
}

const { compact = false, formId = 'contact' } = Astro.props;
const benefits = ['Te respondo yo, no un bot', 'Cada proyecto, a consultar', 'Primera conversación sin compromiso'];
---

<section
  id="contacto"
  class:list={['contact', 'section', 'surface-dark', 'grain', { 'contact--compact': compact }]}
  aria-labelledby={compact ? undefined : 'contact-title'}
  aria-label={compact ? 'Formulario de contacto' : undefined}
>
  <div class="container contact__grid">
    <div class="contact__info">
      {
        !compact && (
          <>
            <p class="eyebrow">Contacto</p>
            <h2 id="contact-title">
              ¿Hablamos de <em>tu web?</em>
            </h2>
            <p class="contact__lead">
              Cuéntame qué tienes en mente. En menos de 24 h te respondo con ideas y los siguientes pasos.
            </p>
          </>
        )
      }

      <ul class="contact__benefits">
        {
          benefits.map((b) => (
            <li>
              <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                <path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              {b}
            </li>
          ))
        }
      </ul>

      <div class="contact__channels">
        <a href={`mailto:${contact.email}`} class="contact__channel">
          <span class="contact__channel-label">Email</span>
          <span>{contact.email}</span>
        </a>
        {
          contact.whatsapp && (
            <a href={`https://wa.me/${contact.whatsapp}`} target="_blank" rel="noopener noreferrer" class="contact__channel">
              <span class="contact__channel-label">WhatsApp</span>
              <span>{contact.phoneDisplay} ↗</span>
            </a>
          )
        }
      </div>
    </div>

    <div class="contact__form-wrap">
      <ContactForm formId={formId} />
    </div>
  </div>
</section>

<style>
  .contact__grid {
    display: grid;
    gap: 3rem;
    align-items: start;
  }

  .contact h2 {
    margin: 0 0 1.25rem;
  }

  .contact__lead {
    margin: 0 0 2rem;
    max-width: 30rem;
    font-size: 1.125rem;
    color: rgba(251, 244, 236, 0.75);
  }

  .contact__benefits {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
  }

  .contact__benefits li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: rgba(251, 244, 236, 0.9);
  }

  .contact__benefits svg {
    flex-shrink: 0;
    color: var(--accent-light);
  }

  .contact__channels {
    display: grid;
    gap: 0.75rem;
  }

  .contact__channel {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 1rem 1.25rem;
    border: 1px solid rgba(251, 244, 236, 0.14);
    border-radius: var(--radius-md);
    transition:
      border-color var(--transition-fast),
      background var(--transition-fast);
    word-break: break-word;
  }

  .contact__channel:hover {
    border-color: rgba(251, 244, 236, 0.4);
    background: rgba(251, 244, 236, 0.04);
  }

  .contact__channel-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(251, 244, 236, 0.5);
  }

  .contact__form-wrap {
    padding: 2rem 1.5rem;
    background: var(--paper);
    color: var(--ink);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-float);
  }

  @media (min-width: 600px) {
    .contact__form-wrap {
      padding: 2.5rem;
    }

    .contact__channels {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 992px) {
    .contact__grid {
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
    }
  }
</style>
