---
import { methodologySteps } from '../../data/methodology';
---

<section class="methodology section" aria-labelledby="methodology-title">
  <div class="container">
    <header class="section-header">
      <p class="section-header__eyebrow">Cómo trabajo</p>
      <h2 id="methodology-title">Del análisis al resultado</h2>
      <p>
        Un proceso claro, inspirado en metodologías de agencias 360º pero con trato personal:
        tú hablas conmigo en cada paso.
      </p>
    </header>

    <ol class="methodology__grid">
      {
        methodologySteps.map((item) => (
          <li class="methodology-card">
            <span class="methodology-card__step" aria-hidden="true">
              {item.step}
            </span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .methodology {
    background: var(--color-surface);
  }

  .methodology__grid {
    display: grid;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: none;
  }

  .methodology-card {
    padding: 1.75rem;
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition:
      transform var(--transition-bounce),
      box-shadow var(--transition-fast);
  }

  .methodology-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-soft);
  }

  .methodology-card__step {
    display: inline-block;
    margin-bottom: 0.75rem;
    font-family: var(--font-tagline);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: var(--color-brand-pink-deep);
  }

  .methodology-card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.125rem;
  }

  .methodology-card p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--color-muted);
    line-height: 1.7;
  }

  @media (min-width: 640px) {
    .methodology__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 992px) {
    .methodology__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
