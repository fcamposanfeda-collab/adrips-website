---
import Button from '../ui/Button.astro';
import ProjectCover from '../ui/ProjectCover.astro';
import { routes } from '../../data/routes';
import { webProjects, statusLabel } from '../../data/portfolio';

// En portada solo proyectos publicados: los «Próximamente» quedan en /proyectos
const featured = webProjects.filter((p) => p.featured && p.status === 'live').slice(0, 3);
---

<section class="work section" aria-labelledby="work-title">
  <div class="container">
    <header class="section-header section-header--split" data-reveal>
      <div>
        <p class="eyebrow">Proyectos</p>
        <h2 id="work-title">Webs recientes, <em>hechas con mimo</em></h2>
      </div>
      <p>
        Cada proyecto empieza por entender el negocio. Aquí irás viendo los casos completos: el reto, las
        decisiones de diseño y los resultados.
      </p>
    </header>

    <div class:list={['work__grid', { 'work__grid--two': featured.length === 2 }]}>
      {
        featured.map((project, i) => (
          <article class:list={['project-card', { 'project-card--wide': i === 0 }]} data-reveal data-reveal-delay={String(i + 1)}>
            <a href={`${routes.projects}#${project.id}`} class="project-card__link">
              <ProjectCover project={project} size={i === 0 ? 'lg' : 'md'} />
              <div class="project-card__meta">
                <div>
                  <h3>{project.title}</h3>
                  <p>{project.category}</p>
                </div>
                <span class:list={['status', `status--${project.status}`]}>{statusLabel[project.status]}</span>
              </div>
            </a>
          </article>
        ))
      }
    </div>

    <div class="work__footer" data-reveal>
      <Button href={routes.projects} variant="outline" arrow>Ver todos los proyectos</Button>
    </div>
  </div>
</section>

<style>
  .work__grid {
    display: grid;
    gap: 2.5rem 2rem;
  }

  .project-card__link {
    display: block;
  }

  .project-card__meta {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .project-card h3 {
    margin: 0 0 0.25rem;
    transition: color var(--transition-fast);
  }

  .project-card:hover h3 {
    color: var(--accent);
  }

  .project-card__meta p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .status {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.375rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    border-radius: var(--radius-full);
    border: 1px solid var(--line-strong);
    color: var(--ink-soft);
  }

  .status::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .status--live {
    color: #3f6b38;
    border-color: #c5d6be;
  }

  .status--in-progress {
    color: #8a5a12;
    border-color: #ead7b0;
  }

  .work__footer {
    margin-top: 3rem;
  }

  @media (min-width: 768px) {
    .work__grid {
      grid-template-columns: 1fr 1fr;
    }

    .project-card--wide {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1100px) {
    .work__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .work__grid--two {
      grid-template-columns: 1fr 1fr;
    }

    .project-card--wide {
      grid-column: auto;
    }
  }
</style>
