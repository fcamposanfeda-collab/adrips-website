---
import Button from '../ui/Button.astro';
import ProjectCover from '../ui/ProjectCover.astro';
import { routes } from '../../data/routes';
import { owner } from '../../data/owner';
import { heroPoints } from '../../data/home';
import { webProjects } from '../../data/portfolio';

const [front, back] = webProjects;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="container hero__grid">
    <div class="hero__content">
      <p class="eyebrow hero__eyebrow" data-reveal>Diseño web · Marketing digital</p>
      <h1 id="hero-title" class="hero__title" data-reveal data-reveal-delay="1">
        Webs que hacen que <em>te elijan</em>.
      </h1>
      <p class="lead hero__lead" data-reveal data-reveal-delay="2">
        Diseño y desarrollo webs a medida para negocios que quieren verse profesionales y conseguir más
        clientes. Con criterio de marketing desde el primer boceto: bonitas, rápidas y pensadas para
        vender.
      </p>
      <div class="hero__actions" data-reveal data-reveal-delay="3">
        <Button href={routes.contact} variant="primary" size="lg" arrow>Pide tu propuesta</Button>
        <Button href={routes.projects} variant="outline" size="lg">Ver proyectos</Button>
      </div>
      <ul class="hero__points" data-reveal data-reveal-delay="4">
        {
          heroPoints.map((p) => (
            <li>
              <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                <path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              {p}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero__visual" aria-hidden="true">
      <div class="hero__stack">
        {back && <div class="hero__card hero__card--back"><ProjectCover project={back} /></div>}
        {front && <div class="hero__card hero__card--front"><ProjectCover project={front} size="lg" eager /></div>}
      </div>

      <div class="hero__chip hero__chip--person">
        <img src={owner.photos.portrait.src} alt="" width="48" height="48" loading="eager" />
        <div>
          <strong>Hola, soy {owner.firstName}</strong>
          <span>Diseño tu web y te ayudo a que funcione</span>
        </div>
      </div>

      <div class="hero__chip hero__chip--stat">
        <span class="hero__chip-star">
          <svg viewBox="0 0 24 24" width="18" height="18"><path d="M12 1c.6 6.6 4.4 10.4 11 11-6.6.6-10.4 4.4-11 11-.6-6.6-4.4-10.4-11-11C7.6 11.4 11.4 7.6 12 1z" fill="currentColor" /></svg>
        </span>
        <span><strong>Diseño + marketing</strong> en un mismo proyecto</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: 3.5rem 5rem;
  }

  .hero__glow {
    position: absolute;
    inset: -20% -10% auto auto;
    width: min(70rem, 120vw);
    aspect-ratio: 1;
    background:
      radial-gradient(closest-side at 60% 40%, rgba(235, 202, 196, 0.75), transparent 70%),
      radial-gradient(closest-side at 30% 70%, rgba(201, 184, 236, 0.4), transparent 70%);
    filter: blur(20px);
    pointer-events: none;
  }

  .hero__grid {
    position: relative;
    display: grid;
    gap: 3.5rem;
    align-items: center;
  }

  .hero__eyebrow {
    margin-bottom: 1.5rem;
  }

  .hero__title {
    margin: 0 0 1.5rem;
    max-width: 12ch;
  }

  .hero__lead {
    margin: 0 0 2.25rem;
    max-width: 36rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .hero__points {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink-soft);
  }

  .hero__points li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .hero__points svg {
    color: var(--accent);
  }

  /* Composición visual */
  .hero__visual {
    position: relative;
    min-height: 20rem;
    padding: 1rem 0 3rem;
  }

  .hero__stack {
    position: relative;
    aspect-ratio: 5 / 4;
  }

  .hero__card {
    position: absolute;
    width: 82%;
  }

  .hero__card--back {
    top: 0;
    right: 0;
    rotate: 3deg;
    opacity: 0.95;
    animation: float-y 9s ease-in-out infinite;
  }

  .hero__card--front {
    left: 0;
    bottom: 0;
    rotate: -2deg;
    box-shadow: var(--shadow-float);
    border-radius: var(--radius-md);
    animation: float-y 8s ease-in-out -3s infinite;
  }

  .hero__card--back :global(.cover),
  .hero__card--front :global(.cover) {
    transform: none;
  }

  .hero__chip {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem 0.75rem 0.75rem;
    font-size: 0.8125rem;
    line-height: 1.35;
    background: rgba(255, 253, 251, 0.92);
    backdrop-filter: blur(8px);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
  }

  .hero__chip strong {
    display: block;
    font-weight: 700;
    color: var(--ink);
  }

  .hero__chip span {
    color: var(--muted);
  }

  .hero__chip--person {
    right: -0.5rem;
    bottom: 0;
    max-width: 17rem;
  }

  .hero__chip--person img {
    width: 3rem;
    height: 3rem;
    flex-shrink: 0;
    border-radius: 50%;
    object-fit: cover;
    object-position: 30% 20%;
  }

  .hero__chip--stat {
    left: -0.5rem;
    top: 8%;
    padding: 0.625rem 1rem 0.625rem 0.625rem;
  }

  .hero__chip--stat strong {
    display: inline;
  }

  .hero__chip-star {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    border-radius: 50%;
    color: var(--white) !important;
    background: var(--accent);
  }

  @media (max-width: 599px) {
    .hero__chip--stat {
      display: none;
    }

    .hero__chip--person {
      right: 0;
      left: 0;
      margin-inline: auto;
      width: fit-content;
    }
  }

  @media (min-width: 992px) {
    .hero {
      padding-block: 5rem 7rem;
    }

    .hero__grid {
      grid-template-columns: 1.05fr 1fr;
      gap: 4rem;
    }

    .hero__visual {
      padding: 0 0 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__card--back,
    .hero__card--front {
      animation: none;
    }
  }
</style>
