---
/** Bloque «Sobre mí» de la home: persona real detrás de la marca */
import Button from '../ui/Button.astro';
import { owner } from '../../data/owner';
import { routes } from '../../data/routes';

const facts = [
  { value: `${owner.yearsExperience}+`, label: 'años en marketing digital' },
  { value: '+40K', label: 'usuarios en la app de Exaccta' },
  { value: '500K', label: 'espectadores en una campaña viral' },
];
---

<section class="about-teaser section" aria-labelledby="about-teaser-title">
  <div class="container about-teaser__grid">
    <div class="about-teaser__media" data-reveal>
      <img
        class="about-teaser__photo"
        src={owner.photos.portrait.src}
        alt={owner.photos.portrait.alt}
        width="960"
        height="1200"
        loading="lazy"
        decoding="async"
      />
      <div class="about-teaser__card" aria-hidden="true">
        <p class="about-teaser__card-label">Guía de estilo · Adrips</p>
        <div class="about-teaser__type">
          <span class="about-teaser__aa">Aa</span>
          <span class="about-teaser__fonts"><strong>Fraunces</strong><small>Manrope · 400–700</small></span>
        </div>
        <ul class="about-teaser__swatches">
          <li style="--c:#4a3340"><span>#4A3340</span></li>
          <li style="--c:#a35f6b"><span>#A35F6B</span></li>
          <li style="--c:#efcfd0"><span>#EFCFD0</span></li>
          <li style="--c:#c9b8ec"><span>#C9B8EC</span></li>
        </ul>
      </div>
    </div>

    <div class="about-teaser__content">
      <p class="eyebrow" data-reveal>Quién está detrás</p>
      <h2 id="about-teaser-title" data-reveal data-reveal-delay="1">
        Soy {owner.firstName}. Diseño webs <em>con cabeza de marketer.</em>
      </h2>
      <div class="about-teaser__text" data-reveal data-reveal-delay="2">
        <p>
          Llevo más de cinco años en marketing digital: he liderado departamentos, lanzado productos y
          construido funnels de captación en SaaS, fintech y B2B. Además, me formé en diseño gráfico.
        </p>
        <p>
          Por eso mis webs no se quedan en bonitas: cada sección tiene un propósito y cada botón un
          objetivo. Trabajas directamente conmigo, de principio a fin.
        </p>
      </div>

      <dl class="about-teaser__facts" data-reveal data-reveal-delay="3">
        {
          facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
      </dl>

      <div data-reveal data-reveal-delay="4">
        <Button href={routes.about} variant="outline" arrow>Conóceme mejor</Button>
      </div>
    </div>
  </div>
</section>

<style>
  .about-teaser__grid {
    display: grid;
    gap: 3.5rem;
    align-items: center;
  }

  .about-teaser__media {
    position: relative;
    max-width: 28rem;
    margin-inline: auto;
    width: 100%;
  }

  .about-teaser__photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-card);
  }

  .about-teaser__card {
    position: absolute;
    right: -1.25rem;
    bottom: -2rem;
    width: min(16rem, 62%);
    padding: 1rem 1rem 1.125rem;
    background: rgba(255, 253, 251, 0.94);
    backdrop-filter: blur(10px);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-float);
    rotate: 3deg;
  }

  @media (max-width: 599px) {
    .about-teaser__card {
      right: -0.25rem;
      width: 66%;
    }
  }

  .about-teaser__card-label {
    margin: 0 0 0.75rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .about-teaser__type {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-bottom: 0.875rem;
    margin-bottom: 0.875rem;
    border-bottom: 1px solid var(--line);
  }

  .about-teaser__aa {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .about-teaser__fonts {
    display: grid;
    line-height: 1.3;
  }

  .about-teaser__fonts strong {
    font-size: 0.875rem;
    color: var(--ink);
  }

  .about-teaser__fonts small {
    font-size: 0.75rem;
    color: var(--muted);
  }

  .about-teaser__swatches {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.375rem;
  }

  .about-teaser__swatches li {
    display: grid;
    gap: 0.3rem;
  }

  .about-teaser__swatches li::before {
    content: '';
    aspect-ratio: 1;
    border-radius: 0.5rem;
    background: var(--c);
    box-shadow: inset 0 0 0 1px rgba(74, 51, 64, 0.08);
  }

  .about-teaser__swatches span {
    font-size: 0.5625rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--muted);
  }

  .about-teaser__content h2 {
    margin: 0 0 1.5rem;
  }

  .about-teaser__text p {
    margin: 0 0 1rem;
    color: var(--muted);
    font-size: 1.0625rem;
  }

  .about-teaser__facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin: 2rem 0 2.25rem;
    padding-block: 1.5rem;
    border-block: 1px solid var(--line);
  }

  .about-teaser__facts div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.375rem;
  }

  .about-teaser__facts dd {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .about-teaser__facts dt {
    font-size: 0.8125rem;
    line-height: 1.35;
    color: var(--muted);
  }

  @media (min-width: 900px) {
    .about-teaser__grid {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 6rem;
    }
  }
</style>
