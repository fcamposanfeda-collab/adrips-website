---
/** Bloque «Sobre mí» de la home: persona real detrás de la marca */
import Button from '../ui/Button.astro';
import { owner } from '../../data/owner';
import { routes } from '../../data/routes';

const facts = [
  { value: `${owner.yearsExperience}+`, label: 'años en marketing digital' },
  { value: '+40K', label: 'usuarios en la app de Exaccta' },
  { value: '500K', label: 'espectadores en una campaña viral' },
];

/** Colores muestreados del cielo de la foto (adriana-retrato.webp) */
const skyPalette = [
  { name: 'Lavanda', hex: '#8F90C7' },
  { name: 'Malva', hex: '#BF95BF' },
  { name: 'Arrebol', hex: '#E9A89B' },
  { name: 'Sol', hex: '#F8D08C' },
];
---

<section class="about-teaser section" aria-labelledby="about-teaser-title">
  <div class="container about-teaser__grid">
    <div class="about-teaser__media" data-reveal>
      <img
        class="about-teaser__photo"
        src={owner.photos.portrait.src}
        alt={owner.photos.portrait.alt}
        width="960"
        height="1200"
        loading="lazy"
        decoding="async"
      />
      <span class="about-teaser__pick" style="left:12%;top:5%;--c:#8f90c7" aria-hidden="true"></span>
      <span class="about-teaser__pick" style="left:62%;top:14%;--c:#e9a89b" aria-hidden="true"></span>
      <span class="about-teaser__pick" style="left:84%;top:9%;--c:#bf95bf" aria-hidden="true"></span>
      <figure class="about-teaser__card">
        <ul class="about-teaser__swatches" aria-label="Colores sacados del atardecer de la foto">
          {
            skyPalette.map((s) => (
              <li style={`--c:${s.hex}`}>
                <b>{s.name}</b>
                <span>{s.hex}</span>
              </li>
            ))
          }
        </ul>
        <figcaption class="about-teaser__note">
          Mi marca nace de aquí: del color que toman las nubes cuando el sol se despide y celebras un día más superado.
        </figcaption>
      </figure>
    </div>

    <div class="about-teaser__content">
      <p class="eyebrow" data-reveal>Quién está detrás</p>
      <h2 id="about-teaser-title" data-reveal data-reveal-delay="1">
        Soy {owner.firstName}. Diseño webs <em>con cabeza de marketer.</em>
      </h2>
      <div class="about-teaser__text" data-reveal data-reveal-delay="2">
        <p>
          Llevo más de cinco años en marketing digital: he liderado departamentos, lanzado productos y
          construido funnels de captación en SaaS, fintech y B2B. Además, me formé en diseño gráfico.
        </p>
        <p>
          Por eso mis webs no se quedan en bonitas: cada sección tiene un propósito y cada botón un
          objetivo. Trabajas directamente conmigo, de principio a fin.
        </p>
      </div>

      <dl class="about-teaser__facts" data-reveal data-reveal-delay="3">
        {
          facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
      </dl>

      <div data-reveal data-reveal-delay="4">
        <Button href={routes.about} variant="outline" arrow>Conóceme mejor</Button>
      </div>
    </div>
  </div>
</section>

<style>
  .about-teaser__grid {
    display: grid;
    gap: 3.5rem;
    align-items: center;
  }

  .about-teaser__media {
    position: relative;
    max-width: 28rem;
    margin-inline: auto;
    width: 100%;
  }

  .about-teaser__photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-card);
  }

  .about-teaser__card {
    position: absolute;
    right: -1.25rem;
    bottom: -2rem;
    width: min(19.5rem, 82%);
    margin: 0;
    padding: 1rem 1rem 1.125rem;
    background: rgba(255, 253, 251, 0.94);
    backdrop-filter: blur(10px);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-float);
    rotate: 3deg;
  }

  @media (max-width: 899px) {
    .about-teaser__media {
      margin-bottom: 2.5rem;
    }
  }

  @media (max-width: 599px) {
    .about-teaser__card {
      right: -0.25rem;
      width: 86%;
    }
  }

  .about-teaser__swatches {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.375rem;
  }

  .about-teaser__swatches li {
    display: grid;
    gap: 0.35rem;
  }

  .about-teaser__swatches li::before {
    content: '';
    aspect-ratio: 1;
    border-radius: 0.5rem;
    background: var(--c);
    box-shadow: inset 0 0 0 1px rgba(74, 51, 64, 0.08);
  }

  .about-teaser__swatches b {
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--ink);
  }

  .about-teaser__swatches span {
    margin-top: -0.2rem;
    font-size: 0.5625rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--muted);
  }

  .about-teaser__note {
    margin: 0.875rem 0 0;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--ink);
  }

  .about-teaser__pick {
    position: absolute;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--c);
    border: 3px solid var(--white);
    outline: 1.5px solid rgba(74, 51, 64, 0.45);
    box-shadow: 0 4px 12px rgba(74, 51, 64, 0.3);
    translate: -50% -50%;
    pointer-events: none;
  }

  .about-teaser__content h2 {
    margin: 0 0 1.5rem;
  }

  .about-teaser__text p {
    margin: 0 0 1rem;
    color: var(--muted);
    font-size: 1.0625rem;
  }

  .about-teaser__facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin: 2rem 0 2.25rem;
    padding-block: 1.5rem;
    border-block: 1px solid var(--line);
  }

  .about-teaser__facts div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.375rem;
  }

  .about-teaser__facts dd {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .about-teaser__facts dt {
    font-size: 0.8125rem;
    line-height: 1.35;
    color: var(--muted);
  }

  @media (min-width: 900px) {
    .about-teaser__grid {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 6rem;
    }
  }
</style>
