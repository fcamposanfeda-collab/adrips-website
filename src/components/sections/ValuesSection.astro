---
import { values } from '../../data/values';
---

<section id="valores" class="values section" aria-labelledby="values-title">
  <div class="container">
    <header class="section-header">
      <p class="section-header__eyebrow">Cómo trabajo</p>
      <h2 id="values-title">Mi forma de hacer las cosas</h2>
      <p>
        Trabajo solo, pero no en solitario: contigo, cerca y con los pies en la tierra. Esto es lo
        que puedes esperar.
      </p>
    </header>

    <div class="values__grid">
      {
        values.map((value) => (
          <article class={`values-card values-card--${value.accent}`}>
            <h3>{value.title}</h3>
            <p>{value.subtitle}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .values__grid {
    display: grid;
    gap: 1rem;
  }

  .values-card {
    padding: 1.75rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    transition: transform var(--transition-bounce), border-color var(--transition-fast);
  }

  .values-card:hover {
    transform: translateY(-4px);
  }

  .values-card--lila:hover {
    border-color: var(--color-lila);
  }

  .values-card--rosa:hover {
    border-color: var(--color-rosa);
  }

  .values-card--menta:hover {
    border-color: var(--color-menta);
  }

  .values-card--naranja:hover {
    border-color: var(--color-naranja);
  }

  .values-card--amarillo:hover {
    border-color: var(--color-amarillo);
  }

  .values-card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.125rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .values-card p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--color-muted);
    line-height: 1.65;
  }

  @media (min-width: 640px) {
    .values__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 992px) {
    .values__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
