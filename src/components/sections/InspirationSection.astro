---
import ImageLightbox from '../ui/ImageLightbox.astro';
import {
  inspirationMeta,
  inspirationPhotos,
} from '../../data/inspiration';

interface Props {
  showIntro?: boolean;
}

const { showIntro = true } = Astro.props;

---

<section class="inspiration section" aria-labelledby="inspiration-title">
  <div class="container">
    {
      showIntro && (
        <div class="inspiration__story" data-reveal>
          <p class="inspiration__palette-note">{inspirationMeta.paletteNote}</p>
        </div>
      )
    }


    <ul class="inspiration__grid" data-inspiration-grid>
      {
        inspirationPhotos.map((photo, index) => (
          <li
            class:list={[
              'inspiration__item',
              `inspiration__item--${photo.category}`,
            ]}
            data-category={photo.category}
            data-reveal
            data-reveal-delay={String((index % 3) + 1)}
          >
            <figure class="inspiration__figure">
              {
                'src' in photo ? (
                  <button
                    type="button"
                    class="inspiration__photo-btn"
                    data-lightbox-src={photo.src}
                    data-lightbox-alt={photo.alt}
                    data-lightbox-caption=""
                    aria-label={`Ampliar imagen: ${photo.alt}`}
                  >
                    <img
                      class="inspiration__photo"
                      src={photo.src}
                      style={photo.position ? `object-position: ${photo.position}` : undefined}
                      alt={photo.alt}
                      width="640"
                      height="800"
                      loading="lazy"
                    />
                  </button>
                ) : (
                  <div
                    class="inspiration__placeholder"
                    style={`background: ${photo.gradient}`}
                    aria-hidden="true"
                  >
                    <span class="inspiration__placeholder-hint">Añade tu foto</span>
                  </div>
                )
              }
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
  <ImageLightbox />
</section>


<style>
  .inspiration {
    background: var(--color-bg-soft);
  }

  .inspiration__story {
    max-width: 40rem;
    margin-bottom: 2rem;
  }

  .inspiration__palette-note {
    margin: 0;
    padding: 1.25rem 1.5rem;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-muted);
    background: linear-gradient(
      135deg,
      rgba(240, 228, 184, 0.45),
      rgba(232, 168, 160, 0.25),
      rgba(200, 176, 224, 0.2)
    );
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }




  .inspiration__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .inspiration__item {
    margin: 0;
  }

  .inspiration__figure {
    position: relative;
    margin: 0;
    height: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    border: 3px solid white;
  }

  .inspiration__photo-btn {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
  }

  .inspiration__photo,
  .inspiration__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .inspiration__placeholder {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 1rem;
  }

  .inspiration__placeholder-hint {
    padding: 0.375rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: rgba(74, 50, 50, 0.65);
    background: rgba(255, 252, 250, 0.75);
    border-radius: var(--radius-full);
    backdrop-filter: blur(6px);
  }

  .inspiration__figure:hover .inspiration__photo {
    transform: scale(1.04);
  }







  @media (min-width: 768px) {
    .inspiration__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }

  }
</style>
