---
import Button from '../ui/Button.astro';
import { pricingPlans } from '../../data/pricing';
import { routes } from '../../data/routes';
---

<section id="precios" class="pricing section" aria-labelledby="pricing-title">
  <div class="container">
    <header class="section-header section-header--split" data-reveal>
      <div>
        <p class="eyebrow">Inversión</p>
        <h2 id="pricing-title">Precios claros <em>para empezar</em></h2>
      </div>
      <p>
        Precios orientativos. Cada proyecto se cierra con un presupuesto por escrito, a medida de lo que
        necesitas y sin costes ocultos.
      </p>
    </header>

    <div class="pricing__grid">
      {
        pricingPlans.map((plan, i) => (
          <article class:list={['plan', { 'plan--featured': plan.highlighted }]} data-reveal data-reveal-delay={String(i + 1)}>
            {plan.highlighted && <span class="plan__badge">Más completo</span>}
            <h3 class="plan__name">{plan.name}</h3>
            <p class="plan__desc">{plan.description}</p>
            <p class="plan__price">
              <span class="plan__amount">{plan.price}</span>
              <span class="plan__period">{plan.period}</span>
            </p>
            <ul class="plan__features">
              {plan.features.map((f) => (
                <li>
                  <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                    <path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {f}
                </li>
              ))}
            </ul>
            <Button href={routes.contact} variant={plan.highlighted ? 'primary' : 'outline'} class="plan__cta">
              Pedir presupuesto
            </Button>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .pricing__grid {
    display: grid;
    gap: 1.25rem;
    align-items: stretch;
  }

  .plan {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 2.25rem 2rem 2rem;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .plan--featured {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--color-on-dark);
    box-shadow: var(--shadow-float);
  }

  .plan__badge {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    padding: 0.3rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--ink);
    background: var(--accent-light);
    border-radius: var(--radius-full);
  }

  .plan__name {
    margin: 0 0 0.5rem;
    font-size: 1.625rem;
  }

  .plan--featured .plan__name {
    color: var(--color-on-dark);
  }

  .plan__desc {
    margin: 0 0 1.75rem;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .plan--featured .plan__desc {
    color: rgba(251, 244, 236, 0.7);
  }

  .plan__price {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0 0 1.75rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--line);
  }

  .plan--featured .plan__price {
    border-color: rgba(251, 244, 236, 0.14);
  }

  .plan__amount {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .plan__period {
    font-size: 0.875rem;
    color: var(--muted);
  }

  .plan--featured .plan__period {
    color: rgba(251, 244, 236, 0.6);
  }

  .plan__features {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 2rem;
    font-size: 0.9375rem;
  }

  .plan__features li {
    display: flex;
    gap: 0.625rem;
    align-items: flex-start;
  }

  .plan__features svg {
    flex-shrink: 0;
    margin-top: 0.2rem;
    color: var(--accent);
  }

  .plan--featured .plan__features svg {
    color: var(--accent-light);
  }

  :global(.plan__cta) {
    margin-top: auto;
    width: 100%;
  }

  .plan--featured :global(.btn--outline) {
    color: var(--color-on-dark);
  }

  @media (min-width: 900px) {
    .pricing__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
