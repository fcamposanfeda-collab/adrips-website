---
/**
 * Ejemplo de papelería de boda (diseño de muestra con nombres ficticios).
 * Imágenes: public/images/eventos/papeleria-boda-*.webp
 */
const pieces = [
  'Invitación y sobre con lacre',
  'Tarjeta de confirmación',
  'Menú',
  'Seating plan',
  'Número de mesa',
  'Tarjetas de sitio',
];
---

<section class="eventos-showcase section" aria-labelledby="eventos-showcase-title">
  <div class="container">
    <header class="section-header" data-reveal>
      <p class="section-header__eyebrow">Ejemplo de papelería</p>
      <h2 id="eventos-showcase-title">Una boda entre olivos, en rosa empolvado y verde salvia</h2>
      <p>
        Así se ve una colección completa: todas las piezas comparten tipografías, paleta y una
        ramita de olivo que se repite de la invitación a la última tarjeta de sitio.
      </p>
    </header>

    <div class="eventos-showcase__grid">
      <figure class="eventos-showcase__figure eventos-showcase__figure--main" data-reveal>
        <img
          src="/images/eventos/papeleria-boda-invitacion.webp"
          alt="Papelería de boda: invitación, sobre rosa con lacre, tarjeta de confirmación, menú y tarjeta de sitio con ramas de olivo"
          width="1800"
          height="1200"
          loading="lazy"
          decoding="async"
        />
        <figcaption>Invitación, sobre con lacre, confirmación, menú y tarjeta de sitio.</figcaption>
      </figure>
      <figure class="eventos-showcase__figure" data-reveal data-reveal-delay="1">
        <img
          src="/images/eventos/papeleria-boda-seating.webp"
          alt="Seating plan «Encuentra tu mesa» con seis mesas, número de mesa y tarjetas de sitio a juego"
          width="1800"
          height="1200"
          loading="lazy"
          decoding="async"
        />
        <figcaption>Seating plan, número de mesa y tarjetas de sitio a juego.</figcaption>
      </figure>
    </div>

    <ul class="eventos-showcase__pieces" data-reveal>
      {pieces.map((piece) => <li>{piece}</li>)}
    </ul>
    <p class="eventos-showcase__note" data-reveal>
      Diseño de muestra con nombres ficticios. Cada colección se crea desde cero con tu paleta, tus
      nombres y el estilo de tu celebración.
    </p>
  </div>
</section>

<style>
  .eventos-showcase {
    background: var(--color-surface);
  }

  .eventos-showcase__grid {
    display: grid;
    gap: 1.5rem;
  }

  .eventos-showcase__figure {
    margin: 0;
  }

  .eventos-showcase__figure img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
  }

  .eventos-showcase__figure figcaption {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    color: var(--color-muted);
  }

  .eventos-showcase__pieces {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .eventos-showcase__pieces li {
    padding: 0.4rem 0.9rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
  }

  .eventos-showcase__note {
    margin: 1rem 0 0;
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  @media (min-width: 992px) {
    .eventos-showcase__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
