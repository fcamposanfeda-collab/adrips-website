---
import Button from '../ui/Button.astro';
import ImageLightbox from '../ui/ImageLightbox.astro';
import { inspirationMeta, inspirationPhotos } from '../../data/inspiration';
import { routes } from '../../data/routes';

const previewPhotos = inspirationPhotos.slice(0, 3);

const categoryLabels = {
  atardecer: 'Atardecer',
  flores: 'Flores',
} as const;
---

<section class="inspiration-teaser section" aria-labelledby="inspiration-teaser-title">
  <div class="container">
    <header class="inspiration-teaser__header" data-reveal>
      <p class="section-header__eyebrow">{inspirationMeta.eyebrow}</p>
      <h2 id="inspiration-teaser-title">{inspirationMeta.title}</h2>
      <div class="inspiration-teaser__copy">
        <p>{inspirationMeta.lead}</p>
        <p>{inspirationMeta.leadExtra}</p>
      </div>
      <p class="inspiration-teaser__palette">{inspirationMeta.paletteNote}</p>
    </header>

    <ul class="inspiration-teaser__grid">
      {
        previewPhotos.map((photo, index) => (
          <li
            class:list={[
              'inspiration-teaser__item',
              `inspiration-teaser__item--${photo.category}`,
              { 'inspiration-teaser__item--featured': index === 0 },
            ]}
            data-reveal
            data-reveal-delay={String(index + 1)}
          >
            <figure class="inspiration-teaser__figure">
              {
                'src' in photo ? (
                  <button
                    type="button"
                    class="inspiration-teaser__photo-btn"
                    data-lightbox-src={photo.src}
                    data-lightbox-alt={photo.alt}
                    data-lightbox-caption={photo.caption ?? ''}
                    aria-label={`Ampliar imagen: ${photo.alt}`}
                  >
                    <img
                      class="inspiration-teaser__photo"
                      src={photo.src}
                      alt=""
                      width="640"
                      height="800"
                      loading="lazy"
                    />
                  </button>
                ) : (
                  <div
                    class="inspiration-teaser__placeholder"
                    style={`background: ${photo.gradient}`}
                    role="img"
                    aria-label={photo.alt}
                  />
                )
              }
              <figcaption class="inspiration-teaser__caption">
                <span class="inspiration-teaser__tag">{categoryLabels[photo.category]}</span>
                {photo.caption && <p>{photo.caption}</p>}
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>

    <div class="inspiration-teaser__cta" data-reveal>
      <Button href={routes.inspiration} variant="outline">
        Ver galería de inspiración
      </Button>
    </div>
  </div>
  <ImageLightbox />
</section>

<style>
  .inspiration-teaser {
    background: var(--color-bg-soft);
  }

  .inspiration-teaser__header {
    max-width: 40rem;
    margin-bottom: 2rem;
    text-align: left;
  }

  .inspiration-teaser__header h2 {
    margin: 0 0 1rem;
  }

  .inspiration-teaser__copy {
    display: grid;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .inspiration-teaser__copy p {
    margin: 0;
    font-size: 1.0625rem;
    color: var(--color-muted);
    line-height: 1.75;
  }

  .inspiration-teaser__palette {
    margin: 0;
    padding: 1rem 1.25rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-muted);
    background: linear-gradient(
      135deg,
      rgba(240, 228, 184, 0.45),
      rgba(232, 168, 160, 0.25),
      rgba(200, 176, 224, 0.2)
    );
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .inspiration-teaser__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin: 0 0 2rem;
    padding: 0;
    list-style: none;
  }

  .inspiration-teaser__item--featured {
    grid-column: 1 / -1;
  }

  .inspiration-teaser__figure {
    position: relative;
    margin: 0;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    border: 3px solid white;
  }

  .inspiration-teaser__item--featured .inspiration-teaser__figure {
    aspect-ratio: 21 / 9;
  }

  .inspiration-teaser__photo-btn {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
  }

  .inspiration-teaser__photo,
  .inspiration-teaser__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .inspiration-teaser__caption {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: 2rem 1rem 0.875rem;
    background: linear-gradient(to top, rgba(74, 50, 50, 0.72), transparent);
    color: var(--color-on-dark);
  }

  .inspiration-teaser__caption p {
    margin: 0.35rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  .inspiration-teaser__tag {
    display: inline-block;
    padding: 0.2rem 0.625rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-radius: var(--radius-full);
  }

  .inspiration-teaser__item--atardecer .inspiration-teaser__tag {
    background: rgba(232, 168, 160, 0.45);
  }

  .inspiration-teaser__item--flores .inspiration-teaser__tag {
    background: rgba(200, 176, 224, 0.45);
  }

  .inspiration-teaser__cta {
    display: flex;
    justify-content: flex-start;
  }

  @media (min-width: 768px) {
    .inspiration-teaser__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }

    .inspiration-teaser__item--featured {
      grid-column: auto;
    }

    .inspiration-teaser__figure,
    .inspiration-teaser__item--featured .inspiration-teaser__figure {
      aspect-ratio: 3 / 2;
    }
  }
</style>
