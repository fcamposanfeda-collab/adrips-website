---
import ProjectCover from '../ui/ProjectCover.astro';
import { webProjects as allWebProjects, marketingCases, statusLabel } from '../../data/portfolio';

/** Los proyectos «Próximamente» se ocultan hasta que tengan web publicada */
const webProjects = allWebProjects.filter((p) => p.status !== 'coming-soon');
---

<section id="proyectos-web" class="portfolio section" aria-labelledby="web-title">
  <div class="container">
    <header class="portfolio__head" data-reveal>
      <h2 id="web-title">Diseño y desarrollo web</h2>
      <span class="portfolio__count">{String(webProjects.length).padStart(2, '0')}</span>
    </header>

    <div class="portfolio__list">
      {
        webProjects.map((p, i) => (
          <article id={p.id} class:list={['case', 'project-card', { 'case--reverse': i % 2 === 1 }]} data-reveal>
            <div class="case__media">
              <ProjectCover project={p} size="lg" />
            </div>
            <div class="case__body">
              <span class:list={['status', `status--${p.status}`]}>{statusLabel[p.status]}</span>
              <h3>{p.title}</h3>
              <p class="case__cat">{p.category}</p>
              <p class="case__desc">{p.description}</p>
              {p.tags && (
                <ul class="case__tags">
                  {p.tags.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              )}
              {p.links.length > 0 && (
                <ul class="case__links">
                  {p.links.map((l) => (
                    <li>
                      <a href={l.href} target="_blank" rel="noopener noreferrer">
                        {l.label} ↗
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section id="marketing" class="portfolio portfolio--mkt section surface-soft" aria-labelledby="mkt-title">
  <div class="container">
    <header class="portfolio__head" data-reveal>
      <div>
        <h2 id="mkt-title">Marketing y campañas</h2>
        <p class="portfolio__sub">
          Trabajo como responsable y equipo de marketing en marcas reales. La experiencia que aplico a cada web.
        </p>
      </div>
      <span class="portfolio__count">{String(marketingCases.length).padStart(2, '0')}</span>
    </header>

    <div class="mkt__grid">
      {
        marketingCases.map((c, i) => (
          <article id={c.id} class="mkt-card" data-reveal data-reveal-delay={String(i + 1)}>
            <div class="mkt-card__top">
              <span class="mkt-card__employer">{c.employer}</span>
              <span class="mkt-card__period">{c.period}</span>
            </div>
            <h3>{c.title}</h3>
            <p class="mkt-card__role">{c.role} · {c.category}</p>
            <p class="mkt-card__desc">{c.description}</p>
            {c.metrics && (
              <ul class="mkt-card__metrics">
                {c.metrics.map((m) => (
                  <li>{m}</li>
                ))}
              </ul>
            )}
            <ul class="case__links">
              {c.links.map((l) => (
                <li>
                  <a href={l.href} target="_blank" rel="noopener noreferrer">
                    {l.label} ↗
                  </a>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .portfolio {
    padding-top: 2rem;
  }

  .portfolio--mkt {
    padding-top: var(--section-padding-mobile);
  }

  .portfolio__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    margin-bottom: 3rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line-strong);
  }

  .portfolio__head h2 {
    margin: 0;
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
  }

  .portfolio__sub {
    margin: 0.75rem 0 0;
    max-width: 36rem;
    color: var(--muted);
  }

  .portfolio__count {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1.25rem;
    color: var(--accent);
  }

  .portfolio__list {
    display: grid;
    gap: 5rem;
  }

  .case {
    display: grid;
    gap: 2rem;
    align-items: center;
    scroll-margin-top: calc(var(--header-height) + 2rem);
  }

  .case__body h3 {
    margin: 1rem 0 0.375rem;
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .case__cat {
    margin: 0 0 1.25rem;
    font-weight: 600;
    color: var(--ink-soft);
  }

  .case__desc {
    margin: 0 0 1.5rem;
    color: var(--muted);
    max-width: 30rem;
  }

  .case__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .case__tags li {
    padding: 0.375rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-full);
  }

  .case__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 1.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .case__links a {
    border-bottom: 1px solid var(--line-strong);
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast);
  }

  .case__links a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.375rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    border-radius: var(--radius-full);
    border: 1px solid var(--line-strong);
    color: var(--ink-soft);
  }

  .status::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .status--live {
    color: #3f6b38;
    border-color: #c5d6be;
  }

  .status--in-progress {
    color: #8a5a12;
    border-color: #ead7b0;
  }

  .mkt__grid {
    display: grid;
    gap: 1.25rem;
  }

  .mkt-card {
    display: flex;
    flex-direction: column;
    padding: 2rem;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    scroll-margin-top: calc(var(--header-height) + 2rem);
  }

  .mkt-card__top {
    display: flex;
    justify-content: space-between;
    margin-bottom: 2rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .mkt-card__employer {
    color: var(--accent);
  }

  .mkt-card__period {
    color: var(--muted);
  }

  .mkt-card h3 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.625rem, 3vw, 2.25rem);
  }

  .mkt-card__role {
    margin: 0 0 1rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ink-soft);
  }

  .mkt-card__desc {
    margin: 0 0 1.5rem;
    color: var(--muted);
  }

  .mkt-card__metrics {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-top: auto;
  }

  .mkt-card__metrics li {
    padding: 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.35;
    background: var(--paper-2);
    border-radius: var(--radius-sm);
  }

  @media (min-width: 900px) {
    .case {
      grid-template-columns: 1.35fr 1fr;
      gap: 4rem;
    }

    .case--reverse .case__media {
      order: 2;
    }

    .mkt__grid {
      grid-template-columns: 1fr 1fr;
    }

    .portfolio--mkt {
      padding-top: var(--section-padding-desktop);
    }
  }
</style>
