---
import { portfolioItems, type PortfolioLink } from '../../data/portfolio';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;

const linkLabel = (link: PortfolioLink) => {
  if (link.type === 'press') return `${link.label} ↗`;
  if (link.type === 'social') return `${link.label} ↗`;
  return `${link.label} ↗`;
};
---

<section
  id="proyectos"
  class:list={['portfolio', 'section', { 'portfolio--compact': compact }]}
  {...(!compact && { 'aria-labelledby': 'portfolio-title' })}
>
  <div class="container">
    {
      !compact && (
        <header class="section-header" data-reveal>
          <p class="section-header__eyebrow">Proyectos</p>
          <h2 id="portfolio-title">Trabajos y campañas que cuentan historias</h2>
          <p>
            Proyectos propios y trabajo en marcas como Exaccta Xpens o Finetwork — con enlaces a
            webs, redes y noticias para que veas el contenido en contexto.
          </p>
        </header>
      )
    }

    <div class="portfolio__grid">
      {
        portfolioItems.map((item, index) => (
          <article
            class:list={[
              'portfolio-card',
              `portfolio-card--${item.accent}`,
              { 'portfolio-card--featured': item.featured },
            ]}
            data-reveal
            data-reveal-delay={String((index % 3) + 1)}
          >
            <div
              class:list={[
                'portfolio-card__visual',
                { 'portfolio-card__visual--pulse': item.featured },
              ]}
              aria-hidden="true"
            >
              <span class="portfolio-card__tag">{item.category.split('·')[0].trim()}</span>
              {item.employer && <span class="portfolio-card__employer">{item.employer}</span>}
            </div>

            <div class="portfolio-card__body">
              {
                item.status === 'coming-soon' && (
                  <span class="portfolio-card__badge">Próximamente</span>
                )
              }
              {
                item.status === 'creative' && (
                  <span class="portfolio-card__badge portfolio-card__badge--creative">Bocetos</span>
                )
              }
              {item.role && <p class="portfolio-card__role">{item.role} · {item.period}</p>}
              <h3>{item.title}</h3>
              <p class="portfolio-card__desc">{item.description}</p>

              {
                item.metrics && item.metrics.length > 0 && (
                  <ul class="portfolio-card__metrics" aria-label="Resultados destacados">
                    {item.metrics.map((metric) => (
                      <li>{metric}</li>
                    ))}
                  </ul>
                )
              }

              {
                item.links.length > 0 && (
                  <ul class="portfolio-card__links">
                    {item.links.map((link) => (
                      <li>
                        <a
                          href={link.href}
                          target="_blank"
                          rel="noopener noreferrer"
                          class={`portfolio-card__link portfolio-card__link--${link.type}`}
                        >
                          {linkLabel(link)}
                        </a>
                      </li>
                    ))}
                  </ul>
                )
              }
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .portfolio--compact {
    padding-top: 0;
  }

  .portfolio__grid {
    display: grid;
    gap: 1.5rem;
  }

  .portfolio-card {
    display: grid;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
    transition:
      transform var(--transition-bounce),
      box-shadow var(--transition-fast),
      border-color var(--transition-fast);
  }

  .portfolio-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-hover);
  }

  .portfolio-card--featured {
    border-color: var(--color-lila);
  }

  .portfolio-card--lila:hover {
    border-color: var(--color-lila);
  }

  .portfolio-card--rosa:hover {
    border-color: var(--color-rosa);
  }

  .portfolio-card--menta:hover {
    border-color: var(--color-menta);
  }

  .portfolio-card--naranja:hover {
    border-color: var(--color-naranja);
  }

  .portfolio-card__visual {
    position: relative;
    min-height: 10rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.25rem;
    overflow: hidden;
  }

  .portfolio-card--lila .portfolio-card__visual {
    background: linear-gradient(145deg, rgba(196, 181, 253, 0.65), rgba(167, 139, 250, 0.25));
  }

  .portfolio-card--rosa .portfolio-card__visual {
    background: linear-gradient(145deg, rgba(249, 168, 212, 0.65), rgba(244, 114, 182, 0.25));
  }

  .portfolio-card--menta .portfolio-card__visual {
    background: linear-gradient(145deg, rgba(110, 231, 183, 0.65), rgba(52, 211, 153, 0.25));
  }

  .portfolio-card--naranja .portfolio-card__visual {
    background: linear-gradient(145deg, rgba(253, 186, 116, 0.65), rgba(251, 146, 60, 0.25));
  }

  .portfolio-card__tag {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text);
    opacity: 0.7;
  }

  .portfolio-card__employer {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 800;
    line-height: 1.1;
    color: var(--color-text);
  }

  .portfolio-card__body {
    padding: 1.5rem 1.75rem 1.75rem;
  }

  .portfolio-card__badge {
    display: inline-block;
    margin-bottom: 0.625rem;
    padding: 0.25rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-lila-strong);
    background: rgba(196, 181, 253, 0.25);
    border-radius: var(--radius-full);
  }

  .portfolio-card__badge--creative {
    color: var(--color-naranja-strong);
    background: rgba(253, 186, 116, 0.3);
  }

  .portfolio-card__role {
    margin: 0 0 0.375rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-muted);
  }

  .portfolio-card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.375rem;
  }

  .portfolio-card__desc {
    margin: 0 0 1rem;
    font-size: 0.9375rem;
    color: var(--color-muted);
    line-height: 1.65;
  }

  .portfolio-card__metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1.25rem;
    padding: 0;
    list-style: none;
  }

  .portfolio-card__metrics li {
    padding: 0.375rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text);
    background: var(--color-bg-soft);
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
  }

  .portfolio-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .portfolio-card__link {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.875rem;
    font-size: 0.8125rem;
    font-weight: 600;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    transition:
      background var(--transition-fast),
      border-color var(--transition-fast),
      transform var(--transition-fast);
  }

  .portfolio-card__link:hover {
    transform: translateY(-2px);
    border-color: var(--color-lila);
    background: rgba(196, 181, 253, 0.15);
  }

  .portfolio-card__link--press {
    border-color: rgba(167, 139, 250, 0.35);
  }

  .portfolio-card__link--social {
    border-color: rgba(249, 168, 212, 0.45);
  }

  @media (min-width: 768px) {
    .portfolio__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .portfolio-card--featured {
      grid-column: 1 / -1;
      grid-template-columns: minmax(12rem, 0.85fr) 1.15fr;
    }

    .portfolio-card--featured .portfolio-card__visual {
      min-height: 100%;
    }
  }
</style>
