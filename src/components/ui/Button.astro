---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost' | 'light';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  external?: boolean;
  arrow?: boolean;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className,
  external = false,
  arrow = false,
} = Astro.props;
---

<a
  href={href}
  class:list={['btn', `btn--${variant}`, `btn--${size}`, className]}
  {...(external && { target: '_blank', rel: 'noopener noreferrer' })}
>
  <span class="btn__label"><slot /></span>
  {
    arrow && (
      <span class="btn__arrow" aria-hidden="true">
        <svg viewBox="0 0 16 16" width="16" height="16" fill="none">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    )
  }
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    line-height: 1;
    white-space: nowrap;
    border-radius: var(--radius-full);
    border: 1px solid transparent;
    transition:
      transform var(--transition-bounce),
      background-color var(--transition-fast),
      color var(--transition-fast),
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .btn:active {
    transform: scale(0.98);
  }

  .btn--sm {
    padding: 0.625rem 1.125rem;
    font-size: 0.875rem;
  }

  .btn--md {
    padding: 0.875rem 1.5rem;
    font-size: 0.9375rem;
  }

  .btn--lg {
    padding: 1.125rem 1.875rem;
    font-size: 1rem;
  }

  .btn__arrow {
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    margin-right: -0.5rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.16);
    transition: transform var(--transition-bounce);
  }

  .btn:hover .btn__arrow {
    transform: translateX(3px);
  }

  .btn--primary {
    color: var(--white);
    background: var(--accent);
    box-shadow: 0 8px 24px -8px rgba(163, 95, 107, 0.6);
  }

  .btn--primary:hover {
    background: var(--accent-hover);
    transform: translateY(-2px);
    box-shadow: 0 14px 30px -10px rgba(163, 95, 107, 0.7);
  }

  .btn--secondary {
    color: var(--white);
    background: var(--ink);
  }

  .btn--secondary:hover {
    background: var(--ink-2);
    transform: translateY(-2px);
  }

  .btn--outline {
    color: var(--ink);
    border-color: var(--line-strong);
    background: transparent;
  }

  .btn--outline .btn__arrow {
    background: var(--paper-2);
  }

  .btn--outline:hover {
    border-color: var(--ink);
    background: var(--white);
    transform: translateY(-2px);
  }

  .btn--ghost {
    color: var(--color-on-dark);
    border-color: rgba(251, 244, 236, 0.28);
    background: transparent;
  }

  .btn--ghost:hover {
    border-color: rgba(251, 244, 236, 0.7);
    background: rgba(251, 244, 236, 0.06);
    transform: translateY(-2px);
  }

  .btn--light {
    color: var(--ink);
    background: var(--paper);
  }

  .btn--light .btn__arrow {
    background: var(--paper-3);
  }

  .btn--light:hover {
    background: var(--white);
    transform: translateY(-2px);
  }
</style>
