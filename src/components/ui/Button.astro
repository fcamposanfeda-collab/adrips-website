---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  size?: 'md' | 'lg';
  class?: string;
  external?: boolean;
}

const { href, variant = 'primary', size = 'md', class: className, external = false } = Astro.props;
---

<a
  href={href}
  class:list={['btn', `btn--${variant}`, `btn--${size}`, className]}
  {...(external && { target: '_blank', rel: 'noopener noreferrer' })}
>
  <slot />
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-weight: 600;
    border-radius: var(--radius-full);
    border: 2px solid transparent;
    transition:
      transform var(--transition-bounce),
      background var(--transition-fast),
      color var(--transition-fast),
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .btn--md {
    padding: 0.8125rem 1.625rem;
    font-size: 0.9375rem;
  }

  .btn--lg {
    padding: 1rem 2rem;
    font-size: 1rem;
  }

  .btn--primary {
    color: var(--color-on-dark);
    background: linear-gradient(135deg, var(--color-brand-pink-deep), var(--color-brand-coral));
    box-shadow: 0 4px 20px rgba(184, 132, 132, 0.35);
  }

  .btn--primary:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 8px 28px rgba(184, 132, 132, 0.45);
  }

  .btn--secondary {
    color: var(--color-text);
    background: var(--color-brand-cream);
    box-shadow: 0 4px 16px rgba(240, 228, 184, 0.4);
  }

  .btn--secondary:hover {
    transform: translateY(-3px) rotate(-1deg);
    background: var(--color-brand-cream-deep);
    color: var(--color-text);
  }

  .btn--outline {
    color: var(--color-text);
    border-color: var(--color-border);
    background: var(--color-surface);
  }

  .btn--outline:hover {
    border-color: var(--color-brand-lavender);
    background: var(--color-bg-soft);
    transform: translateY(-2px);
  }

  .btn--ghost {
    color: var(--color-on-dark);
    border-color: rgba(255, 255, 255, 0.45);
    background: transparent;
  }

  .btn--ghost:hover {
    background: rgba(255, 255, 255, 0.12);
    transform: translateY(-2px);
  }
</style>
