---
/**
 * Portada de proyecto en marco de navegador.
 * Si el proyecto tiene `image`, muestra la captura real; si no, genera una
 * composición tipográfica con los colores del proyecto (placeholder elegante).
 */
import type { PortfolioItem } from '../../data/portfolio';

interface Props {
  project: PortfolioItem;
  size?: 'md' | 'lg';
  eager?: boolean;
  /** Imagen principal de la primera pantalla: se pide con prioridad alta */
  priority?: boolean;
}

const { project, size = 'md', eager = false, priority = false } = Astro.props;
const label = project.domain ?? project.title;
---

<div class:list={['cover', `cover--${project.tone}`, `cover--${size}`]}>
  <div class="cover__bar" aria-hidden="true">
    <span class="cover__dots"><i></i><i></i><i></i></span>
    <span class="cover__url">{label}</span>
  </div>
  <div class="cover__screen">
    {
      project.image ? (
        <img
          src={project.image}
          srcset={`${project.image.replace(/\.webp$/, '-800.webp')} 800w, ${project.image} 1440w`}
          sizes="(max-width: 760px) 92vw, 50vw"
          alt={`Captura de la web de ${project.title}`}
          loading={eager || priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : undefined}
          decoding="async"
          width="1600"
          height="1000"
        />
      ) : (
        <div class="cover__art" aria-hidden="true">
          <div class="cover__nav">
            <span class="cover__brand">{project.title}</span>
            <span class="cover__links">
              <i />
              <i />
              <i />
            </span>
          </div>
          <div class="cover__hero">
            <div class="cover__copy">
              <span class="cover__kicker" />
              <span class="cover__title">{project.title}</span>
              <span class="cover__line" />
              <span class="cover__line cover__line--short" />
              <span class="cover__btn" />
            </div>
            <div class="cover__visual">
              <span class="cover__shape cover__shape--a" />
              <span class="cover__shape cover__shape--b" />
            </div>
          </div>
        </div>
      )
    }
  </div>
</div>

<style>
  .cover {
    --bg: var(--paper-2);
    --fg: var(--ink);
    --a: var(--accent);
    --b: var(--blush);
    --chrome: var(--white);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--chrome);
    box-shadow:
      0 0 0 1px rgba(74, 51, 64, 0.08),
      var(--shadow-card);
    container-type: inline-size;
  }

  .cover--rose {
    --bg: #f6e3df;
    --fg: #3d1f24;
    --a: #c4645b;
    --b: #f1c2b8;
  }

  .cover--terracotta {
    --bg: #efe1cf;
    --fg: #2e1d14;
    --a: #a8532f;
    --b: #d9a47e;
  }

  .cover--ink {
    --bg: #4a3340;
    --fg: #f3ede6;
    --a: #c9b8ec;
    --b: #6e5466;
  }

  .cover--cream {
    --bg: #f6edd2;
    --fg: #2f2616;
    --a: #b08a2e;
    --b: #e8d79e;
  }

  .cover--lavender {
    --bg: #ece6f8;
    --fg: #261d3d;
    --a: #6e57a8;
    --b: #cbbdf0;
  }

  .cover--sage {
    --bg: #e7ede1;
    --fg: #1f2a1c;
    --a: #4d6b45;
    --b: #b9cbb0;
  }

  .cover__bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 0.875rem;
    background: var(--chrome);
    border-bottom: 1px solid rgba(74, 51, 64, 0.06);
  }

  .cover__dots {
    display: flex;
    gap: 5px;
  }

  .cover__dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--paper-3);
  }

  .cover__url {
    flex: 1;
    max-width: 14rem;
    margin-inline: auto;
    padding: 0.25rem 0.75rem;
    font-size: 0.6875rem;
    font-weight: 500;
    text-align: center;
    color: var(--muted);
    background: var(--paper);
    border-radius: var(--radius-full);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cover__screen {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--bg);
  }

  .cover__screen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 1.2s var(--ease-out);
  }

  .cover__art {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: 5cqi 6cqi;
    color: var(--fg);
    transition: transform 1.2s var(--ease-out);
  }

  .cover__nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .cover__brand {
    font-family: var(--font-heading);
    font-size: 3cqi;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .cover__links {
    display: flex;
    gap: 2cqi;
  }

  .cover__links i {
    width: 6cqi;
    height: 0.8cqi;
    border-radius: 1cqi;
    background: currentColor;
    opacity: 0.25;
  }

  .cover__hero {
    flex: 1;
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 5cqi;
    align-items: center;
  }

  .cover__copy {
    display: grid;
    gap: 1.6cqi;
    align-content: center;
  }

  .cover__kicker {
    width: 14cqi;
    height: 0.9cqi;
    border-radius: 1cqi;
    background: var(--a);
  }

  .cover__title {
    font-family: var(--font-heading);
    font-size: 7.4cqi;
    font-weight: 500;
    font-variation-settings: 'SOFT' 100;
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  .cover__line {
    height: 1cqi;
    width: 90%;
    border-radius: 1cqi;
    background: currentColor;
    opacity: 0.16;
  }

  .cover__line--short {
    width: 62%;
  }

  .cover__btn {
    width: 18cqi;
    height: 4.6cqi;
    margin-top: 1cqi;
    border-radius: 4cqi;
    background: var(--a);
  }

  .cover__visual {
    position: relative;
    height: 78%;
  }

  .cover__shape {
    position: absolute;
    border-radius: 2.4cqi;
  }

  .cover__shape--a {
    inset: 0 12% 14% 0;
    background:
      radial-gradient(circle at 30% 25%, rgba(255, 255, 255, 0.35), transparent 55%),
      linear-gradient(150deg, var(--b), var(--a));
  }

  .cover__shape--b {
    right: 0;
    bottom: 0;
    width: 46%;
    height: 44%;
    background: var(--bg);
    border: 0.8cqi solid var(--bg);
    box-shadow: inset 0 0 0 100cqi var(--b);
    opacity: 0.95;
  }

  .cover--lg .cover__url {
    font-size: 0.75rem;
  }

  :global(a:hover) > .cover .cover__art,
  :global(a:hover) > .cover .cover__screen img,
  :global(.project-card:hover) .cover__art,
  :global(.project-card:hover) .cover__screen img {
    transform: scale(1.035);
  }
</style>
