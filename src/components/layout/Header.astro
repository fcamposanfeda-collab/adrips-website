---
import { mainNav } from '../../data/navigation';
import { site } from '../../data/site';
import { brand } from '../../data/brand';
import { routes } from '../../data/routes';
import { isActiveNav } from '../../utils/nav';
import Button from '../ui/Button.astro';
import LogoMark from '../brand/LogoMark.astro';

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand" aria-label={`${brand.name} — Inicio`}>
      <LogoMark size="sm" class="site-header__logo" />
    </a>

    <button
      type="button"
      class="site-header__toggle"
      aria-expanded="false"
      aria-controls="main-navigation"
      aria-label="Abrir menú"
      data-nav-toggle
    >
      <span></span><span></span><span></span>
    </button>

    <nav id="main-navigation" class="site-header__nav" aria-label="Navegación principal" data-nav-menu>
      <ul class="site-header__list">
        {
          mainNav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['site-header__link', { 'is-active': isActiveNav(item.href, currentPath) }]}
                aria-current={isActiveNav(item.href, currentPath) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <Button href={routes.contact} variant="primary" size="md" class="site-header__cta">
        Hablemos
      </Button>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-nav-menu]');

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    menu?.classList.toggle('is-open', !isOpen);
    document.body.classList.toggle('nav-open', !isOpen);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.classList.contains('is-open')) {
      toggle?.setAttribute('aria-expanded', 'false');
      menu.classList.remove('is-open');
      document.body.classList.remove('nav-open');
    }
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      menu.classList.remove('is-open');
      document.body.classList.remove('nav-open');
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(250, 240, 240, 0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    height: var(--header-height);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
    gap: 1rem;
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    color: var(--color-text);
    text-decoration: none;
  }

  :global(.site-header__logo) {
    height: 3rem;
    max-height: calc(var(--header-height) - 1.25rem);
  }

  @media (max-width: 480px) {
    :global(.site-header__logo) {
      height: 2.625rem;
    }
  }

  .site-header__toggle {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 0.5rem;
    background: none;
    border: none;
  }

  .site-header__toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-text);
    border-radius: 2px;
    transition: transform var(--transition-fast);
  }

  .site-header__nav {
    display: none;
  }

  .site-header__list {
    display: flex;
    gap: 1.75rem;
  }

  .site-header__link {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-muted);
    transition: color var(--transition-fast);
  }

  .site-header__link:hover {
    color: var(--color-brand-pink-deep);
  }

  .site-header__link.is-active {
    color: var(--color-brand-pink-deep);
    font-weight: 600;
  }

  .site-header__cta {
    margin-left: 0.5rem;
  }

  @media (min-width: 992px) {
    .site-header__toggle {
      display: none;
    }

    .site-header__nav {
      display: flex;
      align-items: center;
    }
  }

  @media (max-width: 991px) {
    .site-header__nav.is-open {
      display: flex;
      flex-direction: column;
      position: absolute;
      top: var(--header-height);
      left: 0;
      right: 0;
      padding: 1.5rem;
      background: var(--color-surface);
      border-bottom: 1px solid var(--color-border);
      box-shadow: var(--shadow-card);
    }

    .site-header__list {
      flex-direction: column;
      width: 100%;
      gap: 0.25rem;
    }

    .site-header__link {
      display: block;
      padding: 0.625rem 0;
    }

    .site-header__cta {
      margin: 1rem 0 0;
      width: 100%;
    }
  }

  :global(body.nav-open) {
    overflow: hidden;
  }
</style>
