---
import { mainNav } from '../../data/navigation';
import { brand } from '../../data/brand';
import { routes } from '../../data/routes';
import { isActiveNav } from '../../utils/nav';
import Button from '../ui/Button.astro';
import LogoMark from '../brand/LogoMark.astro';

const currentPath = Astro.url.pathname;
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand" aria-label={`${brand.name} — Inicio`}>
      <LogoMark height="1.75rem" />
    </a>

    <nav id="main-navigation" class="site-header__nav" aria-label="Navegación principal" data-nav-menu>
      <ul class="site-header__list">
        {
          mainNav.map((item, i) => (
            <li style={`--i:${i}`}>
              <a
                href={item.href}
                class:list={['site-header__link', { 'is-active': isActiveNav(item.href, currentPath) }]}
                aria-current={isActiveNav(item.href, currentPath) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <Button href={routes.contact} variant="secondary" size="sm" class="site-header__cta" arrow>
        Pide tu propuesta
      </Button>
    </nav>

    <button
      type="button"
      class="site-header__toggle"
      aria-expanded="false"
      aria-controls="main-navigation"
      aria-label="Abrir menú"
      data-nav-toggle
    >
      <span></span><span></span>
    </button>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-nav-menu]');

  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    menu?.classList.toggle('is-open', open);
    document.body.classList.toggle('nav-open', open);
  };

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));

  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--header-height);
    background: rgba(250, 246, 241, 0.78);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent;
    transition:
      border-color var(--transition-fast),
      background var(--transition-fast);
  }

  .site-header.is-scrolled {
    border-bottom-color: var(--line);
    background: rgba(250, 246, 241, 0.9);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    gap: 1rem;
  }

  .site-header__brand {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    color: var(--ink);
    padding-block: 0.5rem;
  }

  .site-header__list {
    display: flex;
    gap: 0.25rem;
  }

  .site-header__link {
    position: relative;
    display: block;
    padding: 0.5rem 0.875rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink-soft);
    border-radius: var(--radius-full);
    transition:
      color var(--transition-fast),
      background var(--transition-fast);
  }

  .site-header__link:hover {
    color: var(--ink);
    background: var(--paper-2);
  }

  .site-header__link.is-active {
    color: var(--ink);
  }

  .site-header__link.is-active::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0.125rem;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent);
    transform: translateX(-50%);
  }

  .site-header__toggle {
    position: relative;
    z-index: 2;
    display: grid;
    place-content: center;
    gap: 6px;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.5rem;
    background: none;
    border: none;
  }

  .site-header__toggle span {
    display: block;
    width: 22px;
    height: 1.5px;
    background: var(--ink);
    border-radius: 2px;
    transition: transform 300ms var(--ease-out);
  }

  .site-header__toggle[aria-expanded='true'] span:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }

  .site-header__toggle[aria-expanded='true'] span:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  @media (min-width: 900px) {
    .site-header__toggle {
      display: none;
    }

    .site-header__nav {
      display: flex;
      align-items: center;
      gap: 1rem;
    }
  }

  @media (max-width: 899px) {
    .site-header__nav {
      position: fixed;
      inset: 0;
      z-index: 1;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: calc(var(--header-height) + 2rem) 1.25rem 2rem;
      background: var(--paper);
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 300ms var(--ease-out),
        visibility 0s linear 300ms;
    }

    .site-header__nav.is-open {
      opacity: 1;
      visibility: visible;
      transition: opacity 300ms var(--ease-out);
    }

    .site-header__list {
      flex-direction: column;
      gap: 0;
    }

    .site-header__list li {
      border-bottom: 1px solid var(--line);
      transform: translateY(12px);
      opacity: 0;
      transition:
        transform 500ms var(--ease-out),
        opacity 500ms var(--ease-out);
      transition-delay: calc(var(--i) * 50ms + 80ms);
    }

    .site-header__nav.is-open .site-header__list li {
      transform: none;
      opacity: 1;
    }

    .site-header__link {
      padding: 1.125rem 0;
      font-family: var(--font-heading);
      font-size: 2rem;
      font-weight: 500;
      letter-spacing: -0.02em;
      color: var(--ink);
      border-radius: 0;
    }

    .site-header__link:hover {
      background: none;
      color: var(--accent);
    }

    .site-header__link.is-active::after {
      left: auto;
      right: 0;
      top: 50%;
      bottom: auto;
      width: 8px;
      height: 8px;
      transform: translateY(-50%);
    }

    :global(.site-header__cta) {
      width: 100%;
      padding-block: 1.125rem !important;
      font-size: 1rem !important;
    }
  }

  :global(body.nav-open) {
    overflow: hidden;
  }

  /* backdrop-filter crea un bloque contenedor: se quita con el menú abierto */
  :global(body.nav-open) .site-header {
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    background: var(--paper);
  }
</style>
