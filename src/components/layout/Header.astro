---
import { mainNav } from '../../data/navigation';
import { brand } from '../../data/brand';
import { routes } from '../../data/routes';
import { isActiveNav } from '../../utils/nav';
import Button from '../ui/Button.astro';
import LogoMark from '../brand/LogoMark.astro';
import Icon from '../ui/Icon.astro';
import type { ServiceIcon } from '../../data/services';

const currentPath = Astro.url.pathname;
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand" aria-label={`${brand.name} — Inicio`}>
      <LogoMark height="2.25rem" />
    </a>

    <nav id="main-navigation" class="site-header__nav" aria-label="Navegación principal" data-nav-menu>
      <ul class="site-header__list">
        {
          mainNav.map((item, i) => (
            <li style={`--i:${i}`} class:list={{ 'has-sub': !!item.children }} data-sub={item.children ? '' : undefined}>
              <a
                href={item.href}
                class:list={['site-header__link', { 'is-active': isActiveNav(item.href, currentPath) }]}
                aria-current={currentPath.replace(/\/$/, '') === item.href ? 'page' : undefined}
              >
                {item.label}
              </a>
              {item.children && (
                <>
                  <button type="button" class="site-header__sub-toggle" aria-expanded="false" aria-label={`Ver ${item.label.toLowerCase()}`} data-sub-toggle>
                    <svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true">
                      <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </button>
                  <div class="site-header__panel">
                    <ul class="site-header__sub">
                      {item.children.map((c) => (
                        <li>
                          <a href={c.href} class:list={['site-header__sublink', { 'is-active': currentPath.replace(/\/$/, '') === c.href }]}>
                            {c.icon && (
                              <span class="site-header__subicon">
                                <Icon name={c.icon as ServiceIcon} size={20} />
                              </span>
                            )}
                            <span>
                              <strong>{c.label}{c.badge && <em class="site-header__badge">{c.badge}</em>}</strong>
                              {c.summary && <small>{c.summary}</small>}
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                    <a href={item.href} class="site-header__panel-all">Ver todos los servicios →</a>
                  </div>
                </>
              )}
            </li>
          ))
        }
      </ul>
      <Button href={routes.contact} variant="secondary" size="sm" class="site-header__cta" arrow>
        Pide tu propuesta
      </Button>
    </nav>

    <button
      type="button"
      class="site-header__toggle"
      aria-expanded="false"
      aria-controls="main-navigation"
      aria-label="Abrir menú"
      data-nav-toggle
    >
      <span></span><span></span>
    </button>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-nav-menu]');

  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    menu?.classList.toggle('is-open', open);
    document.body.classList.toggle('nav-open', open);
  };

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));

  // Submenú Servicios: hover en escritorio (CSS) + botón para teclado, táctil y móvil
  document.querySelectorAll<HTMLButtonElement>('[data-sub-toggle]').forEach((btn) => {
    const li = btn.closest<HTMLElement>('[data-sub]');
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', String(open));
      li?.classList.toggle('is-sub-open', open);
    });
    li?.addEventListener('focusout', (e) => {
      if (window.innerWidth >= 900 && !li.contains(e.relatedTarget as Node)) {
        btn.setAttribute('aria-expanded', 'false');
        li.classList.remove('is-sub-open');
      }
    });
  });
  document.addEventListener('click', (e) => {
    if (window.innerWidth < 900) return;
    document.querySelectorAll<HTMLElement>('[data-sub].is-sub-open').forEach((li) => {
      if (!li.contains(e.target as Node)) {
        li.classList.remove('is-sub-open');
        li.querySelector('[data-sub-toggle]')?.setAttribute('aria-expanded', 'false');
      }
    });
  });

  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--header-height);
    background: rgba(251, 246, 244, 0.78);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent;
    transition:
      border-color var(--transition-fast),
      background var(--transition-fast);
  }

  .site-header.is-scrolled {
    border-bottom-color: var(--line);
    background: rgba(251, 246, 244, 0.9);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    gap: 1rem;
  }

  .site-header__brand {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    color: var(--ink);
    padding-block: 0.5rem;
  }

  .site-header__list {
    display: flex;
    gap: 0.25rem;
  }

  .site-header__link {
    position: relative;
    display: block;
    padding: 0.5rem 0.875rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink-soft);
    border-radius: var(--radius-full);
    transition:
      color var(--transition-fast),
      background var(--transition-fast);
  }

  .site-header__link:hover {
    color: var(--ink);
    background: var(--paper-2);
  }

  .site-header__link.is-active {
    color: var(--ink);
  }

  .site-header__link.is-active::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0.125rem;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent);
    transform: translateX(-50%);
  }

  .site-header__toggle {
    position: relative;
    z-index: 2;
    display: grid;
    place-content: center;
    gap: 6px;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.5rem;
    background: none;
    border: none;
  }

  .site-header__toggle span {
    display: block;
    width: 22px;
    height: 1.5px;
    background: var(--plum);
    border-radius: 2px;
    transition: transform 300ms var(--ease-out);
  }

  .site-header__toggle[aria-expanded='true'] span:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }

  .site-header__toggle[aria-expanded='true'] span:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  /* Submenú */
  .has-sub {
    position: relative;
    display: flex;
    align-items: center;
  }

  .site-header__sub-toggle {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    margin-left: -0.625rem;
    padding: 0;
    color: var(--ink-soft);
    background: none;
    border: 0;
    border-radius: 50%;
    transition: transform 300ms var(--ease-out);
  }

  .is-sub-open > .site-header__sub-toggle {
    transform: rotate(180deg);
  }

  .site-header__sub {
    display: grid;
    gap: 0.25rem;
  }

  .site-header__sublink {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    padding: 0.75rem;
    border-radius: var(--radius-sm);
    transition: background var(--transition-fast);
  }

  .site-header__sublink:hover,
  .site-header__sublink.is-active {
    background: var(--paper-2);
  }

  .site-header__sublink strong {
    display: block;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--ink);
  }

  .site-header__badge {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.1rem 0.45rem;
    font-size: 0.6875rem;
    font-style: normal;
    font-weight: 700;
    vertical-align: 0.1em;
    color: var(--white);
    background: var(--accent);
    border-radius: var(--radius-full);
  }

  .site-header__sublink small {
    display: block;
    margin-top: 0.125rem;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--muted);
  }

  .site-header__subicon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-sm);
    color: var(--accent);
    background: var(--accent-soft);
  }

  .site-header__panel-all {
    display: block;
    margin-top: 0.5rem;
    padding: 0.875rem 0.75rem 0.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent);
    border-top: 1px solid var(--line);
  }

  @media (min-width: 900px) {
    .site-header__panel {
      position: absolute;
      top: calc(100% + 0.75rem);
      left: 50%;
      width: 40rem;
      padding: 0.75rem;
      background: var(--white);
      border: 1px solid var(--line);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-hover);
      opacity: 0;
      visibility: hidden;
      transform: translate(-50%, 6px);
      transition:
        opacity 220ms var(--ease-out),
        transform 220ms var(--ease-out),
        visibility 0s linear 220ms;
    }

    /* Puente invisible para no perder el hover al bajar al panel */
    .site-header__panel::before {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      top: -0.875rem;
      height: 0.875rem;
    }

    .has-sub:hover > .site-header__panel,
    .has-sub.is-sub-open > .site-header__panel {
      opacity: 1;
      visibility: visible;
      transform: translate(-50%, 0);
      transition:
        opacity 220ms var(--ease-out),
        transform 220ms var(--ease-out);
    }

    .has-sub:hover > .site-header__sub-toggle {
      transform: rotate(180deg);
    }

    .site-header__sub {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 900px) {
    .site-header__toggle {
      display: none;
    }

    .site-header__nav {
      display: flex;
      align-items: center;
      gap: 1rem;
    }
  }

  @media (max-width: 899px) {
    .site-header__nav {
      position: fixed;
      inset: 0;
      z-index: 1;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: calc(var(--header-height) + 2rem) 1.25rem 2rem;
      background: var(--paper);
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 300ms var(--ease-out),
        visibility 0s linear 300ms;
    }

    .site-header__nav.is-open {
      opacity: 1;
      visibility: visible;
      transition: opacity 300ms var(--ease-out);
    }

    .site-header__list {
      flex-direction: column;
      gap: 0;
    }

    .site-header__list li {
      border-bottom: 1px solid var(--line);
      transform: translateY(12px);
      opacity: 0;
      transition:
        transform 500ms var(--ease-out),
        opacity 500ms var(--ease-out);
      transition-delay: calc(var(--i) * 50ms + 80ms);
    }

    .site-header__nav.is-open .site-header__list li {
      transform: none;
      opacity: 1;
    }

    .has-sub {
      flex-wrap: wrap;
      justify-content: space-between;
    }

    .site-header__sub-toggle {
      width: 2.75rem;
      height: 2.75rem;
      margin: 0;
      border: 1px solid var(--line-strong);
    }

    .site-header__panel {
      display: none;
      width: 100%;
      padding-bottom: 1rem;
    }

    .is-sub-open > .site-header__panel {
      display: block;
    }

    .site-header__sublink {
      padding: 0.5rem 0;
    }

    .site-header__sublink small,
    .site-header__subicon {
      display: none;
    }

    .site-header__sublink strong {
      font-size: 1.0625rem;
      font-weight: 500;
    }

    .site-header__panel-all {
      padding-inline: 0;
    }

    .site-header__nav {
      overflow-y: auto;
    }

    .site-header__link {
      padding: 1.125rem 0;
      font-family: var(--font-heading);
      font-size: 2rem;
      font-weight: 500;
      letter-spacing: -0.02em;
      color: var(--ink);
      border-radius: 0;
    }

    .site-header__link:hover {
      background: none;
      color: var(--accent);
    }

    .site-header__link.is-active::after {
      left: auto;
      right: 0;
      top: 50%;
      bottom: auto;
      width: 8px;
      height: 8px;
      transform: translateY(-50%);
    }

    :global(.site-header__cta) {
      width: 100%;
      padding-block: 1.125rem !important;
      font-size: 1rem !important;
    }
  }

  :global(body.nav-open) {
    overflow: hidden;
  }

  /* backdrop-filter crea un bloque contenedor: se quita con el menú abierto */
  :global(body.nav-open) .site-header {
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    background: var(--paper);
  }
</style>
