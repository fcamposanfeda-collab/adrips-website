---
import { contact } from '../../data/site';
import { owner } from '../../data/owner';
import { brand } from '../../data/brand';
import { footerNav, legalNav } from '../../data/navigation';
import LogoMark from '../brand/LogoMark.astro';

const year = new Date().getFullYear();
---

<footer class="footer surface-dark grain">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <a href="/" class="footer__logo" aria-label={`${brand.name} — Inicio`}>
          <LogoMark height="2.5rem" />
        </a>
        <p class="footer__claim">
          Diseño webs a medida para negocios que quieren verse profesionales y conseguir más clientes.
        </p>
      </div>

      <div class="footer__col">
        <h2 class="footer__title">Navegación</h2>
        <ul>
          {
            footerNav.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="footer__col">
        <h2 class="footer__title">Contacto</h2>
        <ul>
          <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
          {contact.phoneDisplay && <li><a href={`tel:${contact.phone}`}>{contact.phoneDisplay}</a></li>}
          {
            contact.whatsapp && (
              <li>
                <a href={`https://wa.me/${contact.whatsapp}`} target="_blank" rel="noopener noreferrer">
                  WhatsApp ↗
                </a>
              </li>
            )
          }
        </ul>
      </div>
    </div>

    <p class="footer__wordmark" aria-hidden="true">adrips</p>

    <div class="footer__legal">
      <p>© {year} {owner.fullName} · {brand.name}</p>
      <ul class="footer__legal-links">
        {
          legalNav.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    --logo-star: var(--accent-light);
    padding-top: 5rem;
    overflow: hidden;
    border-top: 1px solid rgba(251, 244, 236, 0.1);
  }

  .footer__top {
    display: grid;
    gap: 2.5rem;
    padding-bottom: 3rem;
  }

  .footer__logo {
    display: inline-block;
    color: var(--color-on-dark);
    margin-bottom: 1.25rem;
  }

  .footer__claim {
    margin: 0;
    max-width: 22rem;
    color: rgba(251, 244, 236, 0.68);
    font-size: 1rem;
  }

  .footer__title {
    margin: 0 0 1rem;
    font-family: var(--font-primary);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(251, 244, 236, 0.5);
  }

  .footer__col ul {
    display: grid;
    gap: 0.625rem;
  }

  .footer__col a {
    color: rgba(251, 244, 236, 0.86);
    transition: color var(--transition-fast);
  }

  .footer__col a:hover {
    color: var(--accent-light);
  }

  .footer__wordmark {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(6rem, 26vw, 22rem);
    font-weight: 500;
    font-variation-settings: 'SOFT' 100;
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: transparent;
    -webkit-text-stroke: 1px rgba(251, 244, 236, 0.14);
    user-select: none;
    text-align: center;
    margin-bottom: -0.02em;
  }

  .footer__legal {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    justify-content: space-between;
    align-items: center;
    padding-block: 1.5rem;
    border-top: 1px solid rgba(251, 244, 236, 0.12);
    font-size: 0.8125rem;
    color: rgba(251, 244, 236, 0.55);
  }

  .footer__legal p {
    margin: 0;
  }

  .footer__legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }

  .footer__legal a:hover {
    color: var(--color-on-dark);
  }

  @media (min-width: 768px) {
    .footer__top {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }
</style>
