---
import { site, contact } from '../../data/site';
import { owner } from '../../data/owner';
import { brand } from '../../data/brand';
import { footerNav, legalNav } from '../../data/navigation';
import LogoMark from '../brand/LogoMark.astro';
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <LogoMark size="footer" class="footer__logo" src={brand.logoFooter} />
      <p class="footer__name">{owner.fullName}</p>
      <p class="footer__tagline text-tagline">{brand.tagline}</p>
      <p class="footer__claim">{site.description}</p>
    </div>

    <div class="footer__col">
      <h2 class="footer__title">Contacto</h2>
      <p><a href={`mailto:${contact.email}`}>{contact.email}</a></p>
      {contact.phoneDisplay && <p><a href={`tel:${contact.phone}`}>{contact.phoneDisplay}</a></p>}
    </div>

    <div class="footer__col">
      <h2 class="footer__title">Enlaces</h2>
      <ul>
        {
          footerNav.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="footer__legal container">
    <p>{site.copyright}</p>
    <ul class="footer__legal-links">
      {
        legalNav.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-footer-bg);
    color: var(--color-on-dark);
    padding-top: 3.5rem;
  }

  .footer__grid {
    display: grid;
    gap: 2rem;
    padding-bottom: 2rem;
  }

  :global(.footer__logo) {
    display: block;
    margin-bottom: 0.75rem;
  }

  .footer__name {
    margin: 0 0 0.5rem;
    font-family: var(--font-heading);
    font-size: 1.375rem;
    font-weight: 400;
    color: var(--color-brand-cream);
  }

  .footer__tagline {
    margin: 0 0 0.75rem;
    font-size: 0.6875rem;
    color: var(--color-brand-cream);
    opacity: 0.92;
  }

  .footer__claim {
    margin: 0;
    font-size: 0.9375rem;
    opacity: 0.88;
    line-height: 1.65;
    max-width: 28rem;
  }

  .footer__title {
    margin: 0 0 0.75rem;
    font-size: 0.6875rem;
    font-weight: 600;
    font-family: var(--font-tagline);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-brand-cream);
    opacity: 0.9;
  }

  .footer__col ul {
    display: grid;
    gap: 0.375rem;
  }

  .footer__col a {
    font-size: 0.9375rem;
    opacity: 0.9;
    transition: opacity var(--transition-fast);
  }

  .footer__col a:hover {
    opacity: 1;
    text-decoration: underline;
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    align-items: center;
    padding-block: 1.25rem;
    border-top: 1px solid rgba(255, 248, 240, 0.15);
    font-size: 0.8125rem;
    opacity: 0.82;
  }

  .footer__legal p {
    margin: 0;
  }

  .footer__legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .footer__grid {
      grid-template-columns: 1.5fr 1fr 1fr;
    }
  }
</style>
