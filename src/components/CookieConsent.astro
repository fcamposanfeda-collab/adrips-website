<div class="cookie-banner" id="cookie-banner" role="dialog" aria-labelledby="cookie-title" hidden>
  <div class="cookie-banner__inner">
    <p id="cookie-title">
      Uso cookies técnicas y, con tu consentimiento, analíticas. Más información en la
      <a href="/politica-de-cookies">política de cookies</a>.
    </p>
    <div class="cookie-banner__actions">
      <button type="button" class="cookie-banner__btn cookie-banner__btn--primary" data-cookie-accept>
        Aceptar
      </button>
      <button type="button" class="cookie-banner__btn" data-cookie-reject>Rechazar</button>
    </div>
  </div>
</div>

<style>
  .cookie-banner {
    position: fixed;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    z-index: 200;
    max-width: 26rem;
    padding: 1.25rem;
    background: var(--plum);
    color: var(--color-on-dark);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-float);
  }

  .cookie-banner__inner {
    display: grid;
    gap: 1rem;
    padding: 0 !important;
  }

  .cookie-banner p {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: rgba(251, 244, 236, 0.85);
  }

  .cookie-banner a {
    color: var(--color-on-dark);
    text-decoration: underline;
  }

  .cookie-banner__actions {
    display: flex;
    gap: 0.5rem;
  }

  .cookie-banner__btn {
    flex: 1;
    padding: 0.625rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    border-radius: var(--radius-full);
    border: 1px solid rgba(251, 244, 236, 0.28);
    background: transparent;
    color: var(--color-on-dark);
    cursor: pointer;
  }

  .cookie-banner__btn--primary {
    background: var(--paper);
    border-color: var(--paper);
    color: var(--ink);
  }
</style>

<script>
  const KEY = 'aps-cookie-consent';
  const banner = document.getElementById('cookie-banner');

  let stored: string | null = null;
  try {
    stored = localStorage.getItem(KEY);
  } catch {}

  if (banner && !stored) {
    banner.hidden = false;
  }

  document.querySelector('[data-cookie-accept]')?.addEventListener('click', () => {
    try {
      localStorage.setItem(KEY, 'accepted');
    } catch {}
    if (banner) banner.hidden = true;
  });

  document.querySelector('[data-cookie-reject]')?.addEventListener('click', () => {
    try {
      localStorage.setItem(KEY, 'rejected');
    } catch {}
    if (banner) banner.hidden = true;
  });
</script>
